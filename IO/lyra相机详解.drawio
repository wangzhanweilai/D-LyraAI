        <mxCell id="pcm-a1" parent="pcm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;movable=0;horizontalStack=0;" value="- UICamera: TObjectPtr&amp;lt;ULyraUICameraManagerComponent&amp;gt;" vertex="1">
