  </diagram>
  <diagram id="lyra-third-person" name="第三人称跟随与防穿透">
    <mxGraphModel dx="2613" dy="1044" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="t0" />
        <mxCell id="t1" parent="t0" />
        <mxCell id="tp-title" parent="t1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="ULyraCameraMode_ThirdPerson - 跟随、偏移、蹲伏与碰撞流程" vertex="1">
          <mxGeometry x="760" y="20" width="2200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tp-legend" parent="t1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="T = 每帧第三人称视图 | C = 蹲伏高度过渡 | P = 防穿透 | 绿色：已实现 | 黄色：可配置/部分接入 | 灰色：未使用接口 | 实线：调用 | 虚线：数据或条件" vertex="1">
          <mxGeometry x="470" y="70" width="2700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="tp-note" parent="t1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;跟随模型&lt;/b&gt;&lt;br&gt;Lyra 第三人称相机不使用 USpringArmComponent。每帧以 Pawn/Character 的位置、胶囊高度和 GetViewRotation 为 Pivot，叠加视角 Pitch 对应的局部偏移曲线，所以角色移动和转向会被下一帧直接跟随。&lt;br&gt;&lt;br&gt;&lt;b&gt;平滑范围&lt;/b&gt;&lt;br&gt;已实现蹲伏高度平滑、模式切换混合、碰撞回缩/拉远平滑；未实现通用 Camera Lag、Rotation Lag 或肩位切换插值。&lt;br&gt;&lt;br&gt;&lt;b&gt;部分接入&lt;/b&gt;&lt;br&gt;ILyraCameraAssistInterface::GetIgnoredActorsForCameraPentration() 已声明，但 PreventCameraPenetration 内对应调用仍是 TODO 注释；接口当前主要使用 GetCameraPreventPenetrationTarget() 与 OnCameraPenetratingTarget()。" vertex="1">
          <mxGeometry x="2850" y="130" width="940" height="330" as="geometry" />
        </mxCell>
        <mxCell id="tp-update" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="UpdateView(DeltaTime) &lt;font color=&quot;#008000&quot;&gt;主入口&lt;/font&gt;" vertex="1">
          <mxGeometry x="100" y="140" width="650" height="300" as="geometry" />
        </mxCell>
        <mxCell id="tp-update-body" parent="tp-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="T1 UpdateForTarget()&lt;br&gt;T2 UpdateCrouchOffset()&lt;br&gt;T3 PivotLocation = GetPivotLocation() + CurrentCrouchOffset&lt;br&gt;T4 PivotRotation = GetPivotRotation()&lt;br&gt;T5 ClampAngle(Pitch, ViewPitchMin, ViewPitchMax)&lt;br&gt;T6 初始化 View Location / Rotation / ControlRotation / FOV&lt;br&gt;T7 应用 Pitch 偏移曲线&lt;br&gt;T8 UpdatePreventPenetration()&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraMode_ThirdPerson.cpp:35-72&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="650" height="270" as="geometry" />
        </mxCell>
        <mxCell id="tp-pivot" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraMode Pivot 计算" vertex="1">
          <mxGeometry x="880" y="140" width="670" height="270" as="geometry" />
        </mxCell>
        <mxCell id="tp-pivot-body" parent="tp-pivot" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="T3a Character：ActorLocation + 胶囊高度差 + CDO BaseEyeHeight&lt;br&gt;T3b 普通 Pawn：GetPawnViewLocation()&lt;br&gt;T3c 非 Pawn：ActorLocation&lt;br&gt;T4a Pawn：GetViewRotation()&lt;br&gt;T4b 非 Pawn：ActorRotation&lt;br&gt;- Pivot 自动适配 Character 胶囊缩短&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraMode.cpp:82-125&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="670" height="240" as="geometry" />
        </mxCell>
        <mxCell id="tp-offset" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Pitch → Local Offset &lt;font color=&quot;#b45f06&quot;&gt;资产可配置&lt;/font&gt;" vertex="1">
          <mxGeometry x="1710" y="140" width="720" height="270" as="geometry" />
        </mxCell>
        <mxCell id="tp-offset-body" parent="tp-offset" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="T7a TargetOffsetCurve.GetVectorValue(Pitch)&lt;br&gt;或&lt;br&gt;T7b RuntimeFloatCurve X / Y / Z 分别 Eval(Pitch)&lt;br&gt;T7c PivotRotation.RotateVector(TargetOffset)&lt;br&gt;T7d View.Location = PivotLocation + 旋转后的局部偏移&lt;br&gt;- 资产：ThirdPersonOffsetCurve / ThirdPersonADSOffsetCurve / ThirdPersonDeathOffsetCurve&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraMode_ThirdPerson.h:39-55; .cpp:50-68&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="720" height="240" as="geometry" />
        </mxCell>
        <mxCell id="tp-crouch" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="蹲伏视角高度过渡" vertex="1">
          <mxGeometry x="110" y="560" width="650" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tp-crouch-body" parent="tp-crouch" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="C1 UpdateForTarget() 检查 Character.IsCrouched()&lt;br&gt;C2 OffsetZ = CDO.CrouchedEyeHeight - CDO.BaseEyeHeight&lt;br&gt;C3 SetTargetCrouchOffset() 保存 Initial / Target，重置 BlendPct&lt;br&gt;C4 BlendPct += DeltaTime × CrouchOffsetBlendMultiplier（默认 5）&lt;br&gt;C5 InterpEaseInOut(Initial, Target, BlendPct)&lt;br&gt;C6 站立时目标恢复 ZeroVector&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraMode_ThirdPerson.cpp:74-91, 352-371&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="650" height="230" as="geometry" />
        </mxCell>
        <mxCell id="tp-safe" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="UpdatePreventPenetration &lt;font color=&quot;#008000&quot;&gt;安全点与瞄准线&lt;/font&gt;" vertex="1">
          <mxGeometry x="900" y="540" width="720" height="320" as="geometry" />
        </mxCell>
        <mxCell id="tp-safe-body" parent="tp-safe" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="P1 bPreventPenetration 判定&lt;br&gt;P2 从 Controller / TargetActor 查询 ILyraCameraAssistInterface&lt;br&gt;P3 GetCameraPreventPenetrationTarget() 可替换保护目标&lt;br&gt;P4 以保护目标碰撞根组件为基础&lt;br&gt;P5 求目标中心到“相机瞄准线”的最近点&lt;br&gt;P6 将 SafeLocation.Z 限制在胶囊范围内&lt;br&gt;P7 GetSquaredDistanceToCollision() 得到贴合胶囊的安全点&lt;br&gt;P8 向胶囊内部 PushIn，避免 Sweep 初始穿透&lt;br&gt;P9 调用 PreventCameraPenetration()&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraMode_ThirdPerson.cpp:111-170&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="720" height="290" as="geometry" />
        </mxCell>
        <mxCell id="tp-feelers" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="FLyraPenetrationAvoidanceFeeler × 7" vertex="1">
          <mxGeometry x="1770" y="540" width="670" height="320" as="geometry" />
        </mxCell>
        <mxCell id="tp-feelers-body" parent="tp-feelers" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="P10 中心主射线：Extent 14，World/PawnWeight 1，逐帧检测&lt;br&gt;P11 左右 ±16°：Weight 0.75，间隔 3 帧&lt;br&gt;P12 左右 ±32°：Weight 0.5，间隔 5 帧&lt;br&gt;P13 上 +20°：Weight 1，间隔 4 帧&lt;br&gt;P14 下 -20°：Weight 0.5，间隔 4 帧&lt;br&gt;- bDoPredictiveAvoidance=false 时仅使用中心射线&lt;br&gt;- 命中后该 feeler 下一帧立即复检&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraMode_ThirdPerson.cpp:22-32, 188-307&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="670" height="290" as="geometry" />
        </mxCell>
        <mxCell id="tp-sweep" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="碰撞 Sweep、过滤与最终回缩" vertex="1">
          <mxGeometry x="2700" y="520" width="850" height="390" as="geometry" />
        </mxCell>
        <mxCell id="tp-sweep-body" parent="tp-sweep" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="P15 BaseRay 按各 feeler AdjustmentRot 旋转&lt;br&gt;P16 SweepSingleByChannel(SafeLoc, RayTarget, ECC_Camera, Sphere)&lt;br&gt;P17 忽略 ViewTarget&lt;br&gt;P18 ActorTag=IgnoreCameraCollision：忽略并加入后续查询忽略列表&lt;br&gt;P19 CameraBlockingVolume 位于目标前方：忽略，避免挡住前视方向&lt;br&gt;P20 计算命中比例并扣除 CollisionPushOutDistance&lt;br&gt;P21 中心射线生成 HardBlockedPct：立即拉近&lt;br&gt;P22 预测射线生成 SoftBlockedPct：按 PenetrationBlendInTime 平滑拉近&lt;br&gt;P23 障碍移除：按 PenetrationBlendOutTime 平滑拉远&lt;br&gt;P24 CameraLoc = SafeLoc + Ray × DistBlockedPct&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraMode_ThirdPerson.cpp:173-349&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="850" height="360" as="geometry" />
        </mxCell>
        <mxCell id="tp-assist" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="ILyraCameraAssistInterface &lt;font color=&quot;#b45f06&quot;&gt;部分接入&lt;/font&gt;" vertex="1">
          <mxGeometry x="900" y="1020" width="720" height="230" as="geometry" />
        </mxCell>
        <mxCell id="tp-assist-body" parent="tp-assist" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ GetCameraPreventPenetrationTarget()：已调用&lt;br&gt;+ OnCameraPenetratingTarget()：低于 ReportPenetrationPercent 时通知，可用于隐藏角色&lt;br&gt;+ GetIgnoredActorsForCameraPentration()：已声明但调用处 TODO 注释&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraAssistInterface.h:17-40; ThirdPerson.cpp:122-167, 195-199&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="720" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tp-debug" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="防穿透调试输出" vertex="1">
          <mxGeometry x="1880" y="1030" width="660" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tp-debug-body" parent="tp-debug" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- DebugActorsHitDuringCameraPenetration&lt;br&gt;- DrawDebugSphere / DrawDebugLine&lt;br&gt;- DrawDebug() 输出每个 HitActor 名称&lt;br&gt;- 仅 ENABLE_DRAW_DEBUG 编译条件下生效&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraMode_ThirdPerson.cpp:93-109, 175-176, 228-234&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="660" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tp-missing" parent="t1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="当前未实现的常见第三人称能力" vertex="1">
          <mxGeometry x="2800" y="1030" width="760" height="210" as="geometry" />
        </mxCell>
        <mxCell id="tp-missing-body" parent="tp-missing" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- 无 SpringArm CameraLag / RotationLag&lt;br&gt;- 无独立自由观察与角色朝向解耦模式&lt;br&gt;- 无左/右肩位动态切换 API&lt;br&gt;- 无按速度自动拉远、滚轮距离缩放&lt;br&gt;- 无锁定目标跟随逻辑（Aim Assist 是输入修正，不是锁定相机）" vertex="1">
          <mxGeometry y="30" width="760" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tp-e1" edge="1" parent="t1" source="tp-update" target="tp-pivot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="T3-T4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tp-e2" edge="1" parent="t1" source="tp-update" target="tp-offset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="T7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tp-e3" edge="1" parent="t1" source="tp-update" target="tp-crouch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="T1-T2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tp-e4" edge="1" parent="t1" source="tp-update" target="tp-safe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="T8 / P1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tp-e5" edge="1" parent="t1" source="tp-safe" target="tp-feelers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="P9-P14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tp-e6" edge="1" parent="t1" source="tp-feelers" target="tp-sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="P15-P24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tp-e7" edge="1" parent="t1" source="tp-safe" target="tp-assist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="目标替换 / 穿透通知">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tp-e8" edge="1" parent="t1" source="tp-sweep" target="tp-debug" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="Debug 命中记录">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lyra-switch-fov-status" name="模式切换、缩放与实现状态">
    <mxGraphModel dx="2613" dy="1044" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="s0" />
        <mxCell id="s1" parent="s0" />
        <mxCell id="st-title" parent="s1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="Lyra 相机模式切换、FOV/缩放、资产与实现状态" vertex="1">
          <mxGeometry x="760" y="20" width="2200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="st-legend" parent="s1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="A = Ability 覆盖 | D = 默认模式回退 | B = 模式栈混合 | F = FOV 输出 | 绿色：已实现 | 黄色：部分/资产依赖 | 灰色：预留/未实现 | 红色：疑似缺陷" vertex="1">
          <mxGeometry x="500" y="70" width="2700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="st-note" parent="s1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;模式优先级&lt;/b&gt;&lt;br&gt;DetermineCameraMode() 每帧执行：AbilityCameraMode 有效时优先；否则读取 PawnExtensionComponent → PawnData.DefaultCameraMode。没有独立优先级数字或多 Ability 相机队列，最后一次 SetAbilityCameraMode 会覆盖字段，只有持有相同 AbilitySpecHandle 的 Clear 才能清除。&lt;br&gt;&lt;br&gt;&lt;b&gt;缩放结论&lt;/b&gt;&lt;br&gt;已实现模式级 FieldOfView、模式间 FOV 插值和单帧 FOV Offset；未实现 Hero Zoom 输入、连续目标 FOV 插值器或相机距离缩放。ADS 缩放通常由 CM_ThirdPersonADS 资产配置较小 FOV，并通过 Ability SetCameraMode 进入。&lt;br&gt;&lt;br&gt;&lt;b&gt;网络边界&lt;/b&gt;&lt;br&gt;未发现 Lyra 自定义相机状态复制/RPC。ControlRotation 遵循 UE Controller/Pawn 的原生网络行为，但 CameraModeStack、偏移、碰撞位置均在本地计算。" vertex="1">
          <mxGeometry x="2860" y="130" width="930" height="350" as="geometry" />
        </mxCell>
        <mxCell id="st-ability" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Gameplay Ability 相机覆盖链" vertex="1">
          <mxGeometry x="80" y="140" width="690" height="310" as="geometry" />
        </mxCell>
        <mxCell id="st-ability-body" parent="st-ability" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="A1 Ability.SetCameraMode(ModeClass)&lt;br&gt;A2 Hero.SetAbilityCameraMode(ModeClass, CurrentSpecHandle)&lt;br&gt;A3 写 AbilityCameraMode 与 OwningSpecHandle&lt;br&gt;A4 每帧 DetermineCameraMode() 返回 AbilityCameraMode&lt;br&gt;A5 CameraComponent.PushCameraMode()&lt;br&gt;A6 Ability.EndAbility() 自动 ClearCameraMode()&lt;br&gt;A7 Hero 仅在 SpecHandle 匹配时清空覆盖&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraGameplayAbility.cpp:195-199, 520-543; LyraHeroComponent.cpp:471-509&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="690" height="280" as="geometry" />
        </mxCell>
        <mxCell id="st-default" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="默认模式回退链" vertex="1">
          <mxGeometry x="920" y="150" width="650" height="250" as="geometry" />
        </mxCell>
        <mxCell id="st-default-body" parent="st-default" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="D1 AbilityCameraMode 为空&lt;br&gt;D2 FindPawnExtensionComponent(Pawn)&lt;br&gt;D3 GetPawnData()&lt;br&gt;D4 返回 PawnData.DefaultCameraMode&lt;br&gt;D5 CameraComponent.UpdateCameraModes() 压入默认模式&lt;br&gt;- PawnData 不存在或默认模式为空时返回 nullptr&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraHeroComponent.cpp:471-492; LyraPawnData.h:51-53&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="650" height="220" as="geometry" />
        </mxCell>
        <mxCell id="st-stack" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="模式栈过渡与输出" vertex="1">
          <mxGeometry x="1720" y="140" width="760" height="320" as="geometry" />
        </mxCell>
        <mxCell id="st-stack-body" parent="st-stack" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="B1 PushCameraMode() 取得/创建模式实例&lt;br&gt;B2 同模式已在索引 0 时直接返回&lt;br&gt;B3 旧模式重入时计算 ExistingStackContribution，避免视觉跳变&lt;br&gt;B4 新模式插入索引 0；底层权重固定 1&lt;br&gt;B5 UpdateCameraMode() 更新 View 与 BlendWeight&lt;br&gt;B6 权重到 1 后移除下层模式并 OnDeactivation()&lt;br&gt;B7 BlendStack() 从 Last() 栈底向索引 0 栈顶混合&lt;br&gt;B8 FLyraCameraModeView 对 Location / Rotation / ControlRotation / FOV 插值&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraMode.cpp:25-46, 264-428&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="760" height="290" as="geometry" />
        </mxCell>
        <mxCell id="st-fov" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="FOV 与“缩放”能力 &lt;font color=&quot;#b45f06&quot;&gt;部分依赖资产&lt;/font&gt;" vertex="1">
          <mxGeometry x="90" y="570" width="760" height="330" as="geometry" />
        </mxCell>
        <mxCell id="st-fov-body" parent="st-fov" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="F1 PlayerCameraManager / CameraMode 默认 FOV = 80°&lt;br&gt;F2 每个 CameraMode 类/Blueprint 可配置 FieldOfView [5°, 170°]&lt;br&gt;F3 模式切换时 FLyraCameraModeView::Blend() 线性插值 FOV&lt;br&gt;F4 CameraComponent.AddFieldOfViewOffset(Delta)：累计单帧增量&lt;br&gt;F5 GetCameraView() 加到最终 FOV 后立即清零&lt;br&gt;F6 DesiredView.FOV 与 CameraComponent.FieldOfView 同步&lt;br&gt;F7 AimAssist GetFOVScale() 按当前 FOV 修正 Pull / Slow 速率&lt;br&gt;&lt;b&gt;部分实现：AddFieldOfViewOffset 在当前 C++ 中没有调用者&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraPlayerCameraManager.h:14-16; LyraCameraMode.h:120-142; LyraCameraComponent.cpp:50-61&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="760" height="300" as="geometry" />
        </mxCell>
        <mxCell id="st-assets" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="相机内容资产 &lt;font color=&quot;#b45f06&quot;&gt;存在，参数/调用依赖资产&lt;/font&gt;" vertex="1">
          <mxGeometry x="970" y="570" width="790" height="360" as="geometry" />
        </mxCell>
        <mxCell id="st-assets-body" parent="st-assets" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="&lt;b&gt;CameraMode / Curve&lt;/b&gt;&lt;br&gt;- Content/Characters/Cameras/CM_ThirdPerson.uasset&lt;br&gt;- CM_ThirdPerson_Death.uasset&lt;br&gt;- ThirdPersonOffsetCurve.uasset / ThirdPersonDeathOffsetCurve.uasset&lt;br&gt;- ShooterCore/Content/Camera/CM_ThirdPersonADS.uasset&lt;br&gt;- ShooterCore/.../ThirdPersonADSOffsetCurve.uasset&lt;br&gt;- TopDownArena/Content/Game/CM_ArenaFramingCamera.uasset&lt;br&gt;&lt;br&gt;&lt;b&gt;CameraShake&lt;/b&gt;&lt;br&gt;- 开火：Rifle / Pistol / Shotgun / 基类 Fire&lt;br&gt;- Character：DamageTaken / Heal&lt;br&gt;&lt;b&gt;状态：资产存在；相机 C++ 主链未发现 StartCameraShake 调用，可能由 GameplayCue/Blueprint 触发&lt;/b&gt;" vertex="1">
          <mxGeometry y="30" width="790" height="330" as="geometry" />
        </mxCell>
        <mxCell id="st-extra" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="其他已实现视图能力" vertex="1">
          <mxGeometry x="1880" y="570" width="650" height="300" as="geometry" />
        </mxCell>
        <mxCell id="st-extra-body" parent="st-extra" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- PostProcessBlendWeight &gt; 0 时输出 PostProcessSettings&lt;br&gt;- XR HeadTrackedCamera 时回退 UCameraComponent 原生视图，同时保留后处理&lt;br&gt;- ReplayPlayerController 在跟随 Pawn 变化时 SetViewTarget(NewPlayerPawn)&lt;br&gt;- PlayerCameraManager.DisplayDebug() 输出位置、旋转、FOV、模式栈与权重&lt;br&gt;- CameraTypeTag 可供玩法读取；武器用 SteadyAimingCamera Tag 驱动散布过渡&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraCameraComponent.cpp:70-82, 101-123; LyraPlayerController.cpp:617-622&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="650" height="270" as="geometry" />
        </mxCell>
        <mxCell id="st-ui" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="UI 相机 / ViewTarget &lt;font color=&quot;#666666&quot;&gt;部分实现&lt;/font&gt;" vertex="1">
          <mxGeometry x="2700" y="570" width="780" height="300" as="geometry" />
        </mxCell>
        <mxCell id="st-ui-body" parent="st-ui" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- UICamera.SetViewTarget(InViewTarget, TransitionParams) 可直接委派 PCM&lt;br&gt;- PlayerCameraManager 已保留“UI 优先”分支&lt;br&gt;- NeedsToUpdateViewTarget() 当前恒 false&lt;br&gt;- UpdateViewTarget() 与 OnShowDebugInfo() 为空&lt;br&gt;- 因此 UI 相机自定义逐帧覆盖未实现；普通 UE SetViewTarget 仍可工作&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraUICameraManagerComponent.cpp:46-65; LyraPlayerCameraManager.cpp:34-45&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="780" height="270" as="geometry" />
        </mxCell>
        <mxCell id="st-bug" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="疑似缺陷：GetBlendInfo 的“栈顶”索引" vertex="1">
          <mxGeometry x="90" y="1060" width="850" height="250" as="geometry" />
        </mxCell>
        <mxCell id="st-bug-body" parent="st-bug" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- PushCameraMode() 把新模式 Insert(..., 0)，索引 0 是逻辑栈顶&lt;br&gt;- BlendStack() 从 Last() 栈底向索引 0 混合，进一步证明栈序&lt;br&gt;- GetBlendInfo() 却使用 CameraModeStack.Last() 作为 TopEntry&lt;br&gt;- 武器依赖该 Tag / Weight 判断 ADS，因此过渡期间可能读到默认底层模式而非 ADS 顶层模式&lt;br&gt;&lt;b&gt;建议核对并考虑改为 CameraModeStack[0]&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraMode.cpp:318, 415-426, 449-463&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="850" height="220" as="geometry" />
        </mxCell>
        <mxCell id="st-partial" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="部分实现 / 需资产或调用点确认" vertex="1">
          <mxGeometry x="1080" y="1060" width="820" height="260" as="geometry" />
        </mxCell>
        <mxCell id="st-partial-body" parent="st-partial" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- ADS / Death CameraMode 资产存在，但具体 Blueprint Ability 调用点不在 C++ 文本中&lt;br&gt;- CameraShake 资产存在，C++ 主链无直接触发点&lt;br&gt;- AddFieldOfViewOffset API 完成，但当前无调用者&lt;br&gt;- Input Modifier 类完成，但具体 IA_Look Modifier 链顺序由 uasset 决定&lt;br&gt;- CameraAssist 忽略 Actor 列表接口未接入&lt;br&gt;- UI Camera 自定义 UpdateViewTarget 未实现" vertex="1">
          <mxGeometry y="30" width="820" height="230" as="geometry" />
        </mxCell>
