  <diagram id="lyra-hero-input" name="Hero 相机输入与视角控制">
    <mxGraphModel dx="2613" dy="1044" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="i0" />
        <mxCell id="i1" parent="i0" />
        <mxCell id="in-title" parent="i1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="LyraHeroComponent - 相机输入与 ControlRotation 流程" vertex="1">
          <mxGeometry x="800" y="20" width="2000" height="45" as="geometry" />
        </mxCell>
        <mxCell id="in-legend" parent="i1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="I = 输入初始化/绑定 | M = Enhanced Input Modifier | L = Look 输入执行 | R = ControlRotation 与相机视图闭环 | 实线：直接调用 | 虚线：资产装配或数据读取" vertex="1">
          <mxGeometry x="500" y="70" width="2600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="in-note" parent="i1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;准确性说明&lt;/b&gt;&lt;br&gt;Input_LookMouse / Input_LookStick 本身不直接移动 CameraComponent，只调用 Pawn.AddControllerYawInput / AddControllerPitchInput 修改控制器旋转；CameraMode 每帧通过 Pawn.GetViewRotation() 读取该旋转并产出视图。&lt;br&gt;&lt;br&gt;&lt;b&gt;资产依赖&lt;/b&gt;&lt;br&gt;源码证明 Modifier 类和设置项已经实现，但具体 IA_Look 资产使用哪些 Modifier、排列顺序以及 ADS/Normal 的 TargetingType 由二进制 InputAction / MappingContext 资产决定，无法仅凭 C++ 完整确认，故以虚线表示。&lt;br&gt;&lt;br&gt;&lt;b&gt;缩放输入&lt;/b&gt;&lt;br&gt;HeroComponent 没有绑定 Zoom 输入，也没有滚轮距离缩放或 SpringArm 长度修改；ADS 视野变化应通过 Ability CameraMode 的 FOV 资产参数实现。" vertex="1">
          <mxGeometry x="2860" y="130" width="920" height="340" as="geometry" />
        </mxCell>
        <mxCell id="in-init" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraHeroComponent::HandleChangeInitState" vertex="1">
          <mxGeometry x="80" y="150" width="640" height="210" as="geometry" />
        </mxCell>
        <mxCell id="in-init-body" parent="in-init" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="I1 DataAvailable → DataInitialized&lt;br&gt;I2 取得 PawnData / 初始化 AbilitySystem&lt;br&gt;I3 本地 LyraPlayerController 且 InputComponent 有效&lt;br&gt;I4 调用 InitializePlayerInput()&lt;br&gt;I5 为所有 Pawn 绑定 DetermineCameraModeDelegate，支持后续观战&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraHeroComponent.cpp:145-181&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="in-bind" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraHeroComponent::InitializePlayerInput" vertex="1">
          <mxGeometry x="850" y="140" width="690" height="270" as="geometry" />
        </mxCell>
        <mxCell id="in-bind-body" parent="in-bind" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="I6 清除现有 Enhanced Input Mapping&lt;br&gt;I7 注册并 AddMappingContext(DefaultInputMappings, Priority)&lt;br&gt;I8 LyraInputComponent.AddInputMappings(InputConfig, Subsystem)&lt;br&gt;I9 BindNativeAction(InputTag.Look.Mouse, Triggered, Input_LookMouse)&lt;br&gt;I10 BindNativeAction(InputTag.Look.Stick, Triggered, Input_LookStick)&lt;br&gt;I11 发送 BindInputsNow 扩展事件&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraHeroComponent.cpp:224-301&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="690" height="240" as="geometry" />
        </mxCell>
        <mxCell id="in-assets" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="InputConfig / InputAction / MappingContext &lt;font color=&quot;#b45f06&quot;&gt;资产装配&lt;/font&gt;" vertex="1">
          <mxGeometry x="1710" y="140" width="720" height="250" as="geometry" />
        </mxCell>
        <mxCell id="in-assets-body" parent="in-assets" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- GameplayTag → InputAction 映射&lt;br&gt;- Mouse / Stick 设备输入与 Trigger&lt;br&gt;- Modifier 实例、执行顺序、TargetingType&lt;br&gt;- 默认映射可注册到 UserSettings 供重绑定&lt;br&gt;&lt;b&gt;状态：运行依赖 uasset；C++ 仅定义绑定入口和 Modifier 能力&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Character/LyraPawnData.h:47-53; Input/LyraInputConfig.*&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="720" height="220" as="geometry" />
        </mxCell>
        <mxCell id="in-settings" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraSettingsShared &lt;font color=&quot;#008000&quot;&gt;视角输入设置&lt;/font&gt;" vertex="1">
          <mxGeometry x="80" y="500" width="650" height="250" as="geometry" />
        </mxCell>
        <mxCell id="in-settings-body" parent="in-settings" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- MouseSensitivityX / MouseSensitivityY&lt;br&gt;- TargetingMultiplier（默认 0.5）&lt;br&gt;- bInvertVerticalAxis / bInvertHorizontalAxis&lt;br&gt;- GamepadLookSensitivityPreset&lt;br&gt;- GamepadTargetingSensitivityPreset&lt;br&gt;- GamepadLookStickDeadZone&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Settings/LyraSettingsShared.h:313-359 及后续 Gamepad 设置&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="650" height="220" as="geometry" />
        </mxCell>
        <mxCell id="in-modifiers" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Lyra Enhanced Input Modifiers &lt;font color=&quot;#008000&quot;&gt;已实现类&lt;/font&gt;" vertex="1">
          <mxGeometry x="850" y="500" width="720" height="330" as="geometry" />
        </mxCell>
        <mxCell id="in-modifiers-body" parent="in-modifiers" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="M1 ULyraSettingBasedScalar：按 SharedSettings 属性名缩放各轴，可用于鼠标 X/Y 与 TargetingMultiplier&lt;br&gt;M2 ULyraInputModifierDeadZone：LookStick 读取设置阈值，支持 Axial / Radial&lt;br&gt;M3 ULyraInputModifierGamepadSensitivity：Normal / ADS 选择不同灵敏度档位表&lt;br&gt;M4 ULyraInputModifierAimInversion：按设置反转水平/垂直轴&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Input/LyraInputModifiers.cpp:38-199&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="720" height="300" as="geometry" />
        </mxCell>
        <mxCell id="in-aimassist" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="UAimAssistInputModifier &lt;font color=&quot;#008000&quot;&gt;ShooterCore 手柄辅助瞄准&lt;/font&gt;" vertex="1">
          <mxGeometry x="1700" y="500" width="740" height="330" as="geometry" />
        </mxCell>
        <mxCell id="in-aimassist-body" parent="in-aimassist" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="M5 ModifyRaw()：更新 OwnerViewData / 目标缓存 / 当前移动输入&lt;br&gt;M6 TargetManager.GetVisibleTargets()：范围、过滤、可见性检测&lt;br&gt;M7 UpdateRotationalVelocity()：按目标权重计算 Pull 与 Slow&lt;br&gt;M8 Pull / Slow 强度平滑，限制最大/最小旋转速率&lt;br&gt;M9 GetFOVScale()：按当前相机 FOV 修正辅助瞄准手感&lt;br&gt;M10 输出修正后的 Look 输入&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;ShooterCore/.../AimAssistInputModifier.cpp:454-755&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="740" height="300" as="geometry" />
        </mxCell>
        <mxCell id="in-mouse" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Input_LookMouse(Value2D)" vertex="1">
          <mxGeometry x="180" y="960" width="570" height="190" as="geometry" />
        </mxCell>
        <mxCell id="in-mouse-body" parent="in-mouse" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="L1 Value.X → Pawn.AddControllerYawInput(Value.X)&lt;br&gt;L2 Value.Y → Pawn.AddControllerPitchInput(Value.Y)&lt;br&gt;- 不乘 DeltaSeconds，适配鼠标位移输入&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraHeroComponent.cpp:404-424&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="570" height="160" as="geometry" />
        </mxCell>
        <mxCell id="in-stick" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Input_LookStick(Value2D)" vertex="1">
          <mxGeometry x="900" y="950" width="620" height="210" as="geometry" />
        </mxCell>
        <mxCell id="in-stick-body" parent="in-stick" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="L3 Yaw = Value.X × 300°/s × DeltaSeconds&lt;br&gt;L4 Pitch = Value.Y × 165°/s × DeltaSeconds&lt;br&gt;L5 Pawn.AddControllerYawInput / PitchInput&lt;br&gt;- 固定基础速率再叠加资产 Modifier 灵敏度&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraHeroComponent.cpp:31-35, 426-449&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="620" height="180" as="geometry" />
        </mxCell>
        <mxCell id="in-controller" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="APlayerController / APawn ControlRotation" vertex="1">
          <mxGeometry x="1710" y="950" width="680" height="210" as="geometry" />
        </mxCell>
        <mxCell id="in-controller-body" parent="in-controller" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="R1 AddController*Input 累加控制旋转&lt;br&gt;R2 Pawn.GetViewRotation() 对模式提供 PivotRotation&lt;br&gt;R3 Character 使用 Controller Yaw 控制朝向&lt;br&gt;R4 Input_Move() 也按 ControlRotation.Yaw 计算移动方向&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;LyraHeroComponent.cpp:374-449; LyraCharacter.cpp:75-77&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="680" height="180" as="geometry" />
        </mxCell>
        <mxCell id="in-mode" parent="i1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraMode → ULyraCameraComponent" vertex="1">
          <mxGeometry x="2670" y="900" width="820" height="280" as="geometry" />
        </mxCell>
        <mxCell id="in-mode-body" parent="in-mode" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="R5 GetPivotRotation() 返回 TargetPawn.GetViewRotation()&lt;br&gt;R6 Pitch Clamp 到模式 ViewPitchMin / ViewPitchMax&lt;br&gt;R7 生成 View.Rotation 与 View.ControlRotation&lt;br&gt;R8 模式栈混合最终 ControlRotation&lt;br&gt;R9 CameraComponent.GetCameraView() 调用 PC.SetControlRotation(最终值)&lt;br&gt;R10 写入 DesiredView Rotation / Location / FOV&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraMode.cpp:114-143; LyraCameraComponent.cpp:32-61&lt;/font&gt;" vertex="1">
          <mxGeometry y="30" width="820" height="250" as="geometry" />
        </mxCell>
        <mxCell id="in-e1" edge="1" parent="i1" source="in-init" target="in-bind" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="I4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e2" edge="1" parent="i1" source="in-assets" target="in-bind" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="InputConfig / Mapping">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e3" edge="1" parent="i1" source="in-settings" target="in-modifiers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="M1-M4 读取设置">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e4" edge="1" parent="i1" source="in-assets" target="in-modifiers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="资产决定 Modifier 链">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e5" edge="1" parent="i1" source="in-assets" target="in-aimassist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="ShooterCore 资产装配">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e6" edge="1" parent="i1" source="in-modifiers" target="in-mouse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="修正后 Value">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e7" edge="1" parent="i1" source="in-aimassist" target="in-stick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" value="修正后手柄 Look">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e8" edge="1" parent="i1" source="in-mouse" target="in-controller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="L1-L2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e9" edge="1" parent="i1" source="in-stick" target="in-controller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="L3-L5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in-e10" edge="1" parent="i1" source="in-controller" target="in-mode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" value="R2-R10 每帧闭环">
