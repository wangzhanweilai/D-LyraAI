          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e5" edge="1" parent="1" source="ov-component" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" target="ov-stack" value="V1 Push + Evaluate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e6" edge="1" parent="1" source="ov-stack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" target="ov-mode" value="V2 Update / Blend">
