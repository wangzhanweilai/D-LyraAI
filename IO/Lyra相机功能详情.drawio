<mxfile host="Electron" agent="Codex" pages="4">
  <diagram id="lyra-camera-overview" name="Lyra 相机功能总览 UML">
    <mxGraphModel dx="710" dy="437" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ov-title" parent="1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="LyraStarterGame 相机功能总览 - 方法级 UML" vertex="1">
          <mxGeometry height="45" width="1800" x="900" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ov-legend" parent="1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="绿色：已实现 | 黄色：部分实现或依赖 Blueprint / uasset 配置 | 灰色：预留或当前未生效 | 红色：疑似实现缺陷 | 实线：直接调用 | 虚线：配置、查询或条件关系" vertex="1">
          <mxGeometry height="28" width="2500" x="530" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ov-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;范围与结论&lt;/b&gt;&lt;br&gt;本图覆盖玩家相机输入、ControlRotation、默认/能力相机模式选择、模式栈混合、第三人称跟随、防穿透、FOV、Aim Assist、俯视模式、ViewTarget、UI 相机和调试输出。核心相机完全在本地计算，未发现 Lyra 自定义相机网络同步。&lt;br&gt;&lt;br&gt;&lt;b&gt;主链编号&lt;/b&gt;&lt;br&gt;&lt;b&gt;C&lt;/b&gt; = 角色与 Hero 初始化；&lt;b&gt;V&lt;/b&gt; = 每帧视图求值；&lt;b&gt;A&lt;/b&gt; = Gameplay Ability 相机覆盖；&lt;b&gt;W&lt;/b&gt; = 武器读取相机混合状态。数字表示同一路径的直接调用顺序。&lt;br&gt;&lt;br&gt;&lt;b&gt;关键边界&lt;/b&gt;&lt;br&gt;CM_ThirdPerson、CM_ThirdPersonADS、CM_ThirdPerson_Death 等是二进制 uasset；本图只把源码可证明的基类能力列为“已实现”，具体资产参数和 Blueprint 调用点标为“资产配置依赖”。" vertex="1">
          <mxGeometry height="330" width="920" x="3950" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ov-character" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ALyraCharacter &lt;font color=&quot;#008000&quot;&gt;角色承载层&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="560" x="80" y="150" as="geometry" />
        </mxCell>
        <mxCell id="ov-character-body" parent="ov-character" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- CameraComponent : ULyraCameraComponent&lt;br&gt;+ 构造：CreateDefaultSubobject(CameraComponent)&lt;br&gt;+ 初始相对位置 (-300, 0, 75)&lt;br&gt;- bUseControllerRotationYaw = true&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Character/LyraCharacter.cpp:72-77&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="560" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-hero" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraHeroComponent &lt;font color=&quot;#008000&quot;&gt;输入与模式决策&lt;/font&gt;" vertex="1">
          <mxGeometry height="290" width="650" x="760" y="130" as="geometry" />
        </mxCell>
        <mxCell id="ov-hero-body" parent="ov-hero" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ HandleChangeInitState()：初始化输入并绑定模式委托&lt;br&gt;+ InitializePlayerInput()：绑定 Move / Look.Mouse / Look.Stick&lt;br&gt;+ Input_LookMouse()：直接累加 Yaw / Pitch&lt;br&gt;+ Input_LookStick()：速率 × DeltaSeconds 后累加&lt;br&gt;+ DetermineCameraMode()：AbilityCameraMode 优先，否则 PawnData 默认模式&lt;br&gt;+ Set/ClearAbilityCameraMode()：按 AbilitySpecHandle 管理覆盖&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Character/LyraHeroComponent.cpp:145, 245, 404, 426, 471&lt;/font&gt;" vertex="1">
          <mxGeometry height="260" width="650" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-pawndata" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="ULyraPawnData &lt;font color=&quot;#b45f06&quot;&gt;数据资产配置&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="620" x="770" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ov-pawndata-body" parent="ov-pawndata" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- InputConfig : ULyraInputConfig&lt;br&gt;- DefaultCameraMode : TSubclassOf&lt;ULyraCameraMode&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Character/LyraPawnData.h:47-53&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="620" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-ability" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraGameplayAbility &lt;font color=&quot;#008000&quot;&gt;临时模式覆盖 API&lt;/font&gt;" vertex="1">
          <mxGeometry height="210" width="570" x="80" y="480" as="geometry" />
        </mxCell>
        <mxCell id="ov-ability-body" parent="ov-ability" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ SetCameraMode(CameraMode)&lt;br&gt;+ ClearCameraMode()&lt;br&gt;+ EndAbility()：自动 ClearCameraMode&lt;br&gt;- ActiveCameraMode&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;AbilitySystem/Abilities/LyraGameplayAbility.cpp:195, 520-543&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="570" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-component" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraComponent &lt;font color=&quot;#008000&quot;&gt;每帧视图入口&lt;/font&gt;" vertex="1">
          <mxGeometry height="340" width="690" x="1530" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ov-component-body" parent="ov-component" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ OnRegister()：创建 CameraModeStack&lt;br&gt;+ GetCameraView(DeltaTime, DesiredView)&lt;br&gt;+ UpdateCameraModes()：执行 DetermineCameraModeDelegate 并 Push&lt;br&gt;+ EvaluateStack()：取得 Location / Rotation / ControlRotation / FOV&lt;br&gt;+ PC.SetControlRotation()：保持控制旋转与最终视图同步&lt;br&gt;+ AddFieldOfViewOffset()：单帧 FOV 增量，应用后清零&lt;br&gt;+ 写回组件 Transform、FOV、PostProcess 和 FMinimalViewInfo&lt;br&gt;+ XR 头部追踪时调用 Super::GetCameraView()&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraComponent.cpp:21-98&lt;/font&gt;" vertex="1">
          <mxGeometry height="310" width="690" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-stack" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraModeStack &lt;font color=&quot;#008000&quot;&gt;模式实例与混合栈&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="710" x="1510" y="550" as="geometry" />
        </mxCell>
        <mxCell id="ov-stack-body" parent="ov-stack" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- CameraModeInstances：按类型缓存 UObject 实例&lt;br&gt;- CameraModeStack：索引 0 为逻辑栈顶&lt;br&gt;+ PushCameraMode()：复用实例、继承旧贡献权重、插入索引 0&lt;br&gt;+ UpdateStack()：逐帧 UpdateCameraMode，权重到 1 后移除下层&lt;br&gt;+ BlendStack()：从栈底向栈顶混合视图&lt;br&gt;+ Activate/DeactivateStack()：触发模式生命周期&lt;br&gt;+ DrawDebug() / GetBlendInfo()&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraMode.cpp:229-464&lt;/font&gt;" vertex="1">
          <mxGeometry height="270" width="710" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-mode" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraMode &lt;font color=&quot;#008000&quot;&gt;可扩展模式基类&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="630" x="2370" y="520" as="geometry" />
        </mxCell>
        <mxCell id="ov-mode-body" parent="ov-mode" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- View：Location / Rotation / ControlRotation / FieldOfView&lt;br&gt;- CameraTypeTag：供玩法查询相机类型&lt;br&gt;- ViewPitchMin / ViewPitchMax&lt;br&gt;- BlendTime / BlendFunction / BlendExponent&lt;br&gt;+ GetPivotLocation()：Character 胶囊与眼高适配&lt;br&gt;+ GetPivotRotation()：Pawn.GetViewRotation()&lt;br&gt;+ UpdateBlending()：Linear / EaseIn / EaseOut / EaseInOut&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraMode.h:41-153; .cpp:82-213&lt;/font&gt;" vertex="1">
          <mxGeometry height="270" width="630" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-third" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraMode_ThirdPerson &lt;font color=&quot;#008000&quot;&gt;第三人称跟随&lt;/font&gt;" vertex="1">
          <mxGeometry height="320" width="680" x="3130" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ov-third-body" parent="ov-third" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ UpdateView()：Pawn Pivot → Pitch 限制 → 偏移曲线 → 防穿透&lt;br&gt;+ UpdateForTarget()：检测蹲伏并设置目标高度偏移&lt;br&gt;+ UpdateCrouchOffset()：EaseInOut 平滑&lt;br&gt;+ UpdatePreventPenetration()：计算安全点并保留瞄准线&lt;br&gt;+ PreventCameraPenetration()：7 个 feeler、ECC_Camera Sweep、硬/软回缩&lt;br&gt;- 无 SpringArm；每帧从 Pawn 视角重算实现跟随&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraCameraMode_ThirdPerson.cpp:22-371&lt;/font&gt;" vertex="1">
          <mxGeometry height="290" width="680" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-pcm" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ALyraPlayerCameraManager &lt;font color=&quot;#008000&quot;&gt;UE CameraManager 接入&lt;/font&gt;" vertex="1">
          <mxGeometry height="230" width="620" x="2360" y="130" as="geometry" />
        </mxCell>
        <mxCell id="ov-pcm-body" parent="ov-pcm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="- 默认 FOV = 80°；Pitch = [-89°, 89°]&lt;br&gt;- UICamera 子组件&lt;br&gt;+ UpdateViewTarget()：预留 UI 相机优先级，否则走 Super&lt;br&gt;+ DisplayDebug()：输出 PCM 与 LyraCameraComponent 状态&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraPlayerCameraManager.cpp:19-64&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="620" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-ui" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="ULyraUICameraManagerComponent &lt;font color=&quot;#666666&quot;&gt;部分预留&lt;/font&gt;" vertex="1">
          <mxGeometry height="230" width="650" x="3130" y="140" as="geometry" />
        </mxCell>
        <mxCell id="ov-ui-body" parent="ov-ui" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ SetViewTarget()：可委派 PCM.SetViewTarget&lt;br&gt;- NeedsToUpdateViewTarget() 固定返回 false&lt;br&gt;- UpdateViewTarget() 为空&lt;br&gt;- OnShowDebugInfo() 为空&lt;br&gt;&lt;b&gt;状态：UI 优先相机更新当前不会进入&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Camera/LyraUICameraManagerComponent.cpp:46-65&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="650" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-topdown" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraMode_TopDownArenaCamera &lt;font color=&quot;#008000&quot;&gt;俯视竞技场&lt;/font&gt;" vertex="1">
          <mxGeometry height="210" width="680" x="3130" y="930" as="geometry" />
        </mxCell>
        <mxCell id="ov-topdown-body" parent="ov-topdown" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ UpdateView()：构造 ArenaBounds&lt;br&gt;+ BoundsSizeToDistance 曲线计算架高距离&lt;br&gt;+ 固定 DefaultPivotRotation 对准场地中心&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;TopDownArena/.../LyraCameraMode_TopDownArenaCamera.cpp:14-29&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="680" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-weapon" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;horizontal=1;startSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="ULyraRangedWeaponInstance &lt;font color=&quot;#b45f06&quot;&gt;相机状态联动&lt;/font&gt;" vertex="1">
          <mxGeometry height="210" width="620" x="2360" y="930" as="geometry" />
        </mxCell>
        <mxCell id="ov-weapon-body" parent="ov-weapon" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;whiteSpace=wrap;html=1;" value="+ GetBlendInfo(Weight, Tag)&lt;br&gt;+ SteadyAimingCamera Tag 命中时按混合权重降低散布&lt;br&gt;&lt;b&gt;注意：当前 GetBlendInfo 取 Last()，与索引 0 为栈顶不一致&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Weapons/LyraRangedWeaponInstance.cpp:195-208&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="620" y="30" as="geometry" />
        </mxCell>
