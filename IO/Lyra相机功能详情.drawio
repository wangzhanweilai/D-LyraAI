        <mxCell id="ov-e9" edge="1" parent="1" source="ov-pcm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;html=1;endArrow=open;endFill=0;" target="ov-component" value="UE ViewTarget 读取组件视图">
          <mxGeometry relative="1" as="geometry" />
