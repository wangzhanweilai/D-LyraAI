  <diagram id="camera-structure" name="1-核心结构关系">
    <mxGraphModel fold="1" pageWidth="2400" dx="1200" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1500" dy="700" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell vertex="1" parent="1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" id="p1-title" value="Lyra 相机类关系 UML - 核心结构与所有权">
          <mxGeometry y="20" width="1800" as="geometry" height="45" x="300" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=8;" id="p1-note" value="&lt;b&gt;阅读规则&lt;/b&gt;&lt;br&gt;每个属性和方法均为独立 mxCell。空心三角=继承；实心菱形=组合；空心菱形=聚合/配置；虚线空心三角=接口实现。组合箭头的菱形端指向整体或其所有权属性。&lt;br&gt;&lt;br&gt;&lt;b&gt;范围&lt;/b&gt;&lt;br&gt;仅列出能够证明相机类关系的成员，不代表类的完整 API。">
          <mxGeometry y="90" width="520" as="geometry" height="150" x="1770" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" id="ue-pcm-head" value="&lt;b&gt;APlayerCameraManager&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;UE 最终相机管理基类&lt;/font&gt;">
          <mxGeometry y="100" width="330" as="geometry" height="52" x="80" />
        </mxCell>
