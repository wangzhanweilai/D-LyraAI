<mxfile host="Electron" agent="Codex" pages="1">
  <diagram id="input-aim" name="3-输入与瞄准辅助">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lyra 相机关系 UML - 输入与瞄准辅助功能及调用流程" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="2600" height="45" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;UML 规范&lt;/b&gt;&lt;br&gt;+ public；- private；# protected。实线空心三角=继承；虚线空心三角=实现；虚线开放箭头=依赖；实线开放箭头=关联。类框按：类名 / 属性 / 方法 三段表示。&lt;br&gt;&lt;b&gt;流程说明&lt;/b&gt;&lt;br&gt;输入修饰器只修改输入值，不直接旋转相机；最终由 HeroComponent 写入 Pawn 的 ControllerRotation。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2760" y="90" width="760" height="170" as="geometry"/></mxCell>

        <mxCell id="inputbase" value="UInputModifier" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="480" height="78" as="geometry"/></mxCell>
        <mxCell id="deadzone" value="ULyraInputModifierDeadZone" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="620" height="250" as="geometry"/></mxCell>
        <mxCell id="deadzone-p" value="+ Type: EDeadZoneType&lt;br&gt;+ UpperThreshold: float&lt;br&gt;+ DeadzoneStick: EDeadzoneStick" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="deadzone"><mxGeometry y="36" width="620" height="100" as="geometry"/></mxCell>
        <mxCell id="deadzone-sep" value="" style="line;strokeWidth=1;fillColor=none;" vertex="1" parent="deadzone"><mxGeometry y="136" width="620" height="8" as="geometry"/></mxCell>
        <mxCell id="deadzone-m" value="# ModifyRaw_Implementation(...): FInputActionValue&lt;br&gt;# GetVisualizationColor_Implementation(...): FLinearColor" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="deadzone"><mxGeometry y="144" width="620" height="100" as="geometry"/></mxCell>
        <mxCell id="sensitivity" value="ULyraInputModifierGamepadSensitivity" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="300" width="680" height="250" as="geometry"/></mxCell>
        <mxCell id="sensitivity-p" value="+ TargetingType: ELyraTargetingType（Normal/ADS）&lt;br&gt;+ SensitivityLevelTable: ULyraAimSensitivityData*" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="sensitivity"><mxGeometry y="36" width="680" height="100" as="geometry"/></mxCell>
        <mxCell id="sensitivity-sep" value="" style="line;strokeWidth=1;fillColor=none;" vertex="1" parent="sensitivity"><mxGeometry y="136" width="680" height="8" as="geometry"/></mxCell>
        <mxCell id="sensitivity-m" value="# ModifyRaw_Implementation(...): FInputActionValue&lt;br&gt;说明：按 Normal/ADS 读取共享设置并映射灵敏度表" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="sensitivity"><mxGeometry y="144" width="680" height="100" as="geometry"/></mxCell>
        <mxCell id="inversion" value="ULyraInputModifierAimInversion" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1480" y="300" width="620" height="180" as="geometry"/></mxCell>
        <mxCell id="inversion-p" value="（读取 ULyraSettingsShared 的水平/垂直反转设置）" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="inversion"><mxGeometry y="36" width="620" height="60" as="geometry"/></mxCell>
        <mxCell id="inversion-sep" value="" style="line;strokeWidth=1;fillColor=none;" vertex="1" parent="inversion"><mxGeometry y="96" width="620" height="8" as="geometry"/></mxCell>
        <mxCell id="inversion-m" value="# ModifyRaw_Implementation(...): FInputActionValue" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="inversion"><mxGeometry y="104" width="620" height="60" as="geometry"/></mxCell>
        <mxCell id="aim" value="UAimAssistInputModifier" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2180" y="300" width="760" height="330" as="geometry"/></mxCell>
        <mxCell id="aim-p" value="+ Settings: FAimAssistSettings（半径、拉拽、减速、FOV、目标数）&lt;br&gt;+ Filter: FAimAssistFilter（队伍、范围、碰撞、死亡过滤）&lt;br&gt;+ TargetingType: ELyraTargetingType&lt;br&gt;# TargetCache0/1: TArray&lt;FLyraAimAssistTarget&gt;&lt;br&gt;# OwnerViewData: FAimAssistOwnerViewData" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="aim"><mxGeometry y="36" width="760" height="150" as="geometry"/></mxCell>
        <mxCell id="aim-sep" value="" style="line;strokeWidth=1;fillColor=none;" vertex="1" parent="aim"><mxGeometry y="186" width="760" height="8" as="geometry"/></mxCell>
        <mxCell id="aim-m" value="# ModifyRaw_Implementation(...): FInputActionValue&lt;br&gt;# UpdateTargetData(DeltaTime): void&lt;br&gt;# UpdateRotationalVelocity(PC,...): FRotator&lt;br&gt;# CalculateTargetStrengths(Target,...): void&lt;br&gt;# GetLookRates(LookInput): FRotator" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="aim"><mxGeometry y="194" width="760" height="125" as="geometry"/></mxCell>

        <mxCell id="hero" value="ULyraHeroComponent" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="680" height="230" as="geometry"/></mxCell>
        <mxCell id="hero-p" value="- InputConfig / DefaultInputMappings&lt;br&gt;- CameraComponent: ULyraCameraComponent*" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="hero"><mxGeometry y="36" width="680" height="70" as="geometry"/></mxCell>
        <mxCell id="hero-sep" value="" style="line;strokeWidth=1;fillColor=none;" vertex="1" parent="hero"><mxGeometry y="106" width="680" height="8" as="geometry"/></mxCell>
        <mxCell id="hero-m" value="# InitializePlayerInput(...): 绑定 Look_Mouse / Look_Stick&lt;br&gt;# Input_LookMouse(Value): AddControllerYaw/PitchInput&lt;br&gt;# Input_LookStick(Value): 速率 × DeltaTime 后写入控制旋转" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="hero"><mxGeometry y="114" width="680" height="105" as="geometry"/></mxCell>
        <mxCell id="pawn" value="APawn" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="800" width="520" height="130" as="geometry"/></mxCell>
        <mxCell id="pawn-m" value="+ AddControllerYawInput(Value): void&lt;br&gt;+ AddControllerPitchInput(Value): void" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="pawn"><mxGeometry y="36" width="520" height="80" as="geometry"/></mxCell>
        <mxCell id="manager" value="UAimAssistTargetManagerComponent" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1500" y="760" width="700" height="190" as="geometry"/></mxCell>
        <mxCell id="manager-m" value="+ GetVisibleTargets(Filter, Settings, OwnerData, Old, OutNew): void&lt;br&gt;# DetermineTargetVisibility(...): void&lt;br&gt;# DoesTargetPassFilter(...): bool" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="manager"><mxGeometry y="36" width="700" height="130" as="geometry"/></mxCell>
        <mxCell id="target" value="UAimAssistTargetComponent" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=36;collapsible=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2320" y="760" width="620" height="160" as="geometry"/></mxCell>
        <mxCell id="target-m" value="- TargetData: FAimAssistTargetOptions&lt;br&gt;+ GatherTargetOptions(OutTargetData): void" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=6;html=1;" vertex="1" parent="target"><mxGeometry y="36" width="620" height="100" as="geometry"/></mxCell>

        <mxCell id="flow-title" value="输入与瞄准辅助执行流程（每次 Look 输入触发）" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="1110" width="1800" height="40" as="geometry"/></mxCell>
        <mxCell id="f1" value="1. Enhanced Input 读取鼠标/手柄 Look 输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1190" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="f2" value="2. Lyra DeadZone&lt;br&gt;按 Move/Look 设置取得下阈值，Axis/Radial 重映射到 ±1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="1190" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="f3" value="3. 灵敏度 / 反转&lt;br&gt;Normal 或 ADS 查设置；映射标量；应用轴反转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="970" y="1190" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="f4" value="4. UAimAssistInputModifier::ModifyRaw_Implementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1440" y="1190" width="440" height="80" as="geometry"/></mxCell>
        <mxCell id="f5" value="5. OwnerViewData.UpdateViewData(PC)&lt;br&gt;保存投影矩阵、ViewTransform、玩家移动和 TeamID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1960" y="1190" width="430" height="80" as="geometry"/></mxCell>
        <mxCell id="f6" value="6. UpdateTargetData&lt;br&gt;TargetManager 收集/过滤/可见性检测，双缓存交换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2470" y="1190" width="430" height="80" as="geometry"/></mxCell>
        <mxCell id="f7" value="7. UpdateRotationalVelocity&lt;br&gt;按 ScreenBounds、AssistWeight、Pull/Slow 配置累计旋转和减速" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1370" width="480" height="90" as="geometry"/></mxCell>
        <mxCell id="f8" value="8. GetLookRates + 输出 CurrentValue&lt;br&gt;应用 FOV 缩放、输入需求、最大拉拽/最小减速限制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="1370" width="480" height="90" as="geometry"/></mxCell>
        <mxCell id="f9" value="9. Hero Input_LookMouse / Input_LookStick&lt;br&gt;调用 AddControllerYawInput / AddControllerPitchInput" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1180" y="1370" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="f10" value="10. 相机模式读取 ControllerRotation&lt;br&gt;第三人称/其他 CameraMode 输出最终视图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1760" y="1370" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="f11" value="实际效果：死区过滤抖动；灵敏度/反转符合设置；瞄准辅助对目标产生柔和拉拽与减速，同时保持玩家输入和镜头控制权。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2280" y="1370" width="660" height="120" as="geometry"/></mxCell>

        <mxCell id="param" value="关键参数含义（FAimAssistSettings）" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="1580" width="1600" height="40" as="geometry"/></mxCell>
        <mxCell id="param-note" value="&lt;b&gt;目标选择&lt;/b&gt; TargetRange、MaxNumberOfTargets、Filter：决定候选目标范围和排除规则。&lt;br&gt;&lt;b&gt;锁定判定&lt;/b&gt; AssistInner/OuterReticleWidth/Height、ReticleDepth、TargetWeightCurve：决定目标是否进入内圈/外圈及随时间增加的权重。&lt;br&gt;&lt;b&gt;修正强度&lt;/b&gt; PullInner/OuterStrength、PullLerpIn/OutRate、PullMaxRotationRate：控制拉拽；SlowInner/OuterStrength、SlowLerpIn/OutRate、SlowMinRotationRate：控制减速。&lt;br&gt;&lt;b&gt;开关&lt;/b&gt; bRequireInput、bApplyPull、bApplySlowing、bUseDynamicSlow、bUseRadialLookRates、bEnableAsyncVisibilityTrace。&lt;br&gt;&lt;b&gt;数据流&lt;/b&gt; FInputActionValue → OwnerViewData → FLyraAimAssistTarget 双缓存 → FRotator → FInputActionValue → ControllerRotation。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="1640" width="2840" height="260" as="geometry"/></mxCell>

        <mxCell id="e1" value="继承" style="endArrow=block;endFill=0;html=1;dashed=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="deadzone" target="inputbase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="继承" style="endArrow=block;endFill=0;html=1;dashed=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sensitivity" target="inputbase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="继承" style="endArrow=block;endFill=0;html=1;dashed=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="inversion" target="inputbase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="继承" style="endArrow=block;endFill=0;html=1;dashed=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="aim" target="inputbase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="依赖：消费处理后的 Look" style="endArrow=open;endFill=0;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="aim" target="hero"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="依赖：写入控制旋转" style="endArrow=open;endFill=0;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hero" target="pawn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="依赖：OwnerViewData.PlayerController" style="endArrow=open;endFill=0;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aim" target="manager"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="依赖：收集可见目标" style="endArrow=open;endFill=0;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="aim" target="manager"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="关联：注册目标组件" style="endArrow=open;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="manager" target="target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e1" value="调用顺序" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e2" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e3" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e4" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e5" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e6" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
