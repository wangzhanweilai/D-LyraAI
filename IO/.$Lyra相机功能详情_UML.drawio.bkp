  <diagram id="lyra-thirdperson-status" name="第三人称功能与实现状态">
    <mxGraphModel dx="2600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="s0" /><mxCell id="s1" parent="s0" />
        <mxCell id="s-title" parent="s1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="Lyra Third-Person Camera - Feature Call Flow and Status" vertex="1"><mxGeometry x="900" y="20" width="2000" height="45" as="geometry" /></mxCell>
        <mxCell id="s-legend" parent="s1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="T = 第三人称视图 | C = 蹲伏 | P = 防穿透 | A = Assist | O = 扩展模式 | 绿色：已实现 | 黄色：资产/部分接入 | 灰色：未实现 | 红色：疑似缺陷" vertex="1"><mxGeometry x="520" y="70" width="2700" height="28" as="geometry" /></mxCell>
        <mxCell id="s-note" parent="s1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;跟随实现&lt;/b&gt;&lt;br&gt;无 USpringArmComponent。每帧从 Pawn/Character 的位置、胶囊、眼高和 ViewRotation 重新计算 Pivot，再应用 Pitch 偏移曲线，因此角色移动和转向自然被跟随。&lt;br&gt;&lt;br&gt;&lt;b&gt;已实现平滑&lt;/b&gt;&lt;br&gt;模式切换、FOV、蹲伏高度、碰撞软回缩和障碍消失后的拉远。未实现通用 CameraLag、RotationLag、肩位切换或滚轮距离缩放。" vertex="1"><mxGeometry x="3450" y="130" width="850" height="250" as="geometry" /></mxCell>

        <mxCell id="s-update" parent="s1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;resizeParent=1;resizeLast=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraCameraMode_ThirdPerson::UpdateView" vertex="1"><mxGeometry x="80" y="140" width="700" height="346" as="geometry" /></mxCell>
        <mxCell id="s-update-f-r1" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="- TargetOffsetCurve / RuntimeFloatCurves" vertex="1"><mxGeometry y="26" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-f-r2" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="- CurrentCrouchOffset" vertex="1"><mxGeometry y="52" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-f-r3" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="- View: FLyraCameraModeView" vertex="1"><mxGeometry y="78" width="700" height="26" as="geometry" /></mxCell>
        <mxCell id="s-update-line" parent="s-update" style="line;strokeWidth=1;fillColor=none;strokeColor=#82b366;" vertex="1"><mxGeometry y="104" width="700" height="8" as="geometry" /></mxCell>
        <mxCell id="s-update-m-r1" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="T1 UpdateForTarget(DeltaTime)" vertex="1"><mxGeometry y="112" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-m-r2" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="T2 UpdateCrouchOffset(DeltaTime)" vertex="1"><mxGeometry y="138" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-m-r3" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="T3 PivotLocation = GetPivotLocation + CrouchOffset" vertex="1"><mxGeometry y="164" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-m-r4" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="T4 PivotRotation = GetPivotRotation" vertex="1"><mxGeometry y="190" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-m-r5" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="T5 Clamp Pitch" vertex="1"><mxGeometry y="216" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-m-r6" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="T6 初始化 View + FieldOfView" vertex="1"><mxGeometry y="242" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-m-r7" parent="s-update" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="T7 Eval Pitch → Local TargetOffset" vertex="1"><mxGeometry y="268" width="700" height="26" as="geometry" /></mxCell><mxCell id="s-update-m-r8" parent="s-update" style=