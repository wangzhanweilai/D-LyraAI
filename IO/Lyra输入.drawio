      <mxCell id="p2-e08" value="I8 → I9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-08" target="p2-09"><mxGeometry relative="1" as="geometry" /></mxCell>
