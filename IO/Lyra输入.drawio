<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-08-30T00:00:00.000Z" agent="Codex" version="24.7.17" pages="2">
  <diagram id="lyra-input-init" name="1-输入配置与绑定">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1100" math="0" shadow="0">
      <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      <mxCell id="p1-title" value="&lt;b&gt;Lyra 输入系统：配置、初始化与移动动作绑定&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1220" height="50" as="geometry" /></mxCell>
      <mxCell id="p1-subtitle" value="重点：输入组件类型如何确定，Input Mapping Context 如何注入，以及 InputTag_Move 如何最终绑定到 Input_Move。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1380" height="35" as="geometry" /></mxCell>
      <mxCell id="p1-01" value="&lt;b&gt;1. 指定默认输入组件类型&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：Config/DefaultInput.ini:33&lt;br&gt;&lt;b&gt;配置&lt;/b&gt;：DefaultInputComponentClass = ULyraInputComponent&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：Pawn 创建默认 InputComponent&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：引擎按配置实例化 Lyra 扩展组件&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：后续可使用 GameplayTag 查找并绑定 InputAction" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="260" as="geometry" /></mxCell>
      <mxCell id="p1-02" value="&lt;b&gt;2. ALyraCharacter::SetupPlayerInputComponent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：Character/LyraCharacter.cpp:263&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：PlayerInputComponent&lt;br&gt;&lt;b&gt;执行&lt;/b&gt;：&lt;br&gt;① 调用 Super&lt;br&gt;② 通知 PawnExtComponent&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：进入 Lyra Pawn 初始化状态链&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;：此处不直接绑定 WASD" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="350" height="260" as="geometry" /></mxCell>
      <mxCell id="p1-03" value="&lt;b&gt;3. ULyraPawnExtensionComponent::SetupPlayerInputComponent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：Character/LyraPawnExtensionComponent.cpp:208&lt;br&gt;&lt;br&gt;&lt;b&gt;核心逻辑&lt;/b&gt;：标记输入组件已创建，并触发初始化状态重新检查。&lt;br&gt;&lt;br&gt;&lt;b&gt;关键判断&lt;/b&gt;：PawnData、Controller、LocalPlayer、InputComponent 等依赖是否就绪&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：HeroComponent 可进入 InitState_DataInitialized" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="380" height="260" as="geometry" /></mxCell>
      <mxCell id="p1-04" value="&lt;b&gt;4. ULyraHeroComponent::InitializePlayerInput&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：Character/LyraHeroComponent.cpp:225&lt;br&gt;&lt;br&gt;&lt;b&gt;前置校验&lt;/b&gt;：Pawn、PlayerController、LocalPlayer、EnhancedInputSubsystem、PawnData 必须有效&lt;br&gt;&lt;b&gt;准备&lt;/b&gt;：Subsystem-&amp;gt;ClearAllMappings()&lt;br&gt;&lt;b&gt;数据源&lt;/b&gt;：PawnData-&amp;gt;InputConfig + DefaultInputMappings&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：建立当前 Pawn 的完整输入环境" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1310" y="130" width="390" height="260" as="geometry" /></mxCell>
      <mxCell id="p1-05" value="&lt;b&gt;5. 注入 DefaultInputMappings&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：LyraHeroComponent.cpp:252&lt;br&gt;&lt;br&gt;&lt;b&gt;循环处理&lt;/b&gt;：&lt;br&gt;① 同步加载 UInputMappingContext&lt;br&gt;② 可选注册到 Enhanced Input User Settings&lt;br&gt;③ AddMappingContext(IMC, Priority, Options)&lt;br&gt;&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：IMC_Default 等映射上下文开始参与按键求值" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1310" y="470" width="390" height="280" as="geometry" /></mxCell>
      <mxCell id="p1-06" value="&lt;b&gt;6. 读取 ULyraPawnData::InputConfig&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：Character/LyraPawnData.h:49&lt;br&gt;&lt;br&gt;&lt;b&gt;资产&lt;/b&gt;：InputData_Hero / InputData_SimplePawn&lt;br&gt;&lt;b&gt;内容&lt;/b&gt;：NativeInputActions 与 AbilityInputActions&lt;br&gt;&lt;br&gt;&lt;b&gt;关键映射&lt;/b&gt;：InputTag_Move → IA_Move&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：为 GameplayTag 驱动绑定提供查询表" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="380" height="280" as="geometry" /></mxCell>
      <mxCell id="p1-07" value="&lt;b&gt;7. ULyraInputComponent::AddInputMappings&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：Input/LyraInputComponent.cpp&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：InputConfig、EnhancedInputSubsystem&lt;br&gt;&lt;b&gt;作用&lt;/b&gt;：应用 Lyra 输入配置中需要的映射与玩家可配置键位数据&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：输入资产、用户设置与 Enhanced Input 子系统保持一致" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="350" height="280" as="geometry" /></mxCell>
      <mxCell id="p1-08" value="&lt;b&gt;8. BindNativeAction(InputTag_Move)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：LyraHeroComponent.cpp:285&lt;br&gt;&lt;b&gt;模板实现&lt;/b&gt;：Input/LyraInputComponent.h:43&lt;br&gt;&lt;br&gt;&lt;b&gt;执行步骤&lt;/b&gt;：&lt;br&gt;① FindNativeInputActionForTag(InputTag_Move)&lt;br&gt;② 找到 IA_Move&lt;br&gt;③ BindAction(IA_Move, Triggered, HeroComponent, Input_Move)&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：移动动作触发时调用 Input_Move" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="330" height="280" as="geometry" /></mxCell>
      <mxCell id="p1-assets" value="&lt;b&gt;输入资产职责&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;IMC_Default&lt;/b&gt;：物理键 → InputAction；包含 W/A/S/D、IA_Move 与 Negate 等 Modifier。&lt;br&gt;&lt;b&gt;IA_Move&lt;/b&gt;：Value Type = Axis2D，表示平面移动意图。&lt;br&gt;&lt;b&gt;InputData_Hero&lt;/b&gt;：GameplayTag → InputAction，负责语义绑定。&lt;br&gt;&lt;br&gt;&lt;b&gt;区别&lt;/b&gt;：IMC 解决“按了什么键”；InputConfig 解决“这个动作调用哪个游戏逻辑”。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="760" height="220" as="geometry" /></mxCell>
      <mxCell id="p1-result" value="&lt;b&gt;初始化完成后的绑定结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;W/A/S/D → IMC_Default → IA_Move (Axis2D) → InputTag_Move → ETriggerEvent::Triggered → ULyraHeroComponent::Input_Move&lt;br&gt;&lt;br&gt;&lt;b&gt;输入系统边界&lt;/b&gt;：到 Input_Move 收到 FInputActionValue 为止属于 Enhanced Input/Lyra 绑定层；之后进入方向转换和 PawnMovement 输入累积。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="820" width="840" height="220" as="geometry" /></mxCell>
      <mxCell id="p1-e01" value="① 创建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-01" target="p1-02"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p1-e02" value="② 通知" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-02" target="p1-03"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p1-e03" value="③ 状态就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-03" target="p1-04"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p1-e04" value="④ 加载 IMC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-04" target="p1-05"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p1-e05" value="⑤ 读取 InputConfig" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-05" target="p1-06"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p1-e06" value="⑥ 应用配置" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-06" target="p1-07"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p1-e07" value="⑦ 绑定 Move" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-07" target="p1-08"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lyra-input-move" name="2-WASD到玩家移动">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1380" math="0" shadow="0">
      <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      <mxCell id="p2-title" value="&lt;b&gt;WASD 按键到玩家移动：Lyra 输入逻辑执行流程&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="50" as="geometry" /></mxCell>
      <mxCell id="p2-subtitle" value="主链突出 Enhanced Input 的映射、修饰、求值、Tag 绑定和回调分发；CharacterMovement 物理与网络层仅保留关键入口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="35" as="geometry" /></mxCell>
      <mxCell id="p2-01" value="&lt;b&gt;I1. 键盘产生物理按键状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：W / A / S / D 按下、保持或释放&lt;br&gt;&lt;b&gt;数据&lt;/b&gt;：单个按键通常提供 0 或 1&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：Enhanced Input 接收本帧按键状态&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;：物理键本身不知道“移动”语义" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-02" value="&lt;b&gt;I2. IMC_Default 映射到 IA_Move&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：W/A/S/D&lt;br&gt;&lt;b&gt;动作&lt;/b&gt;：IA_Move（Axis2D）&lt;br&gt;&lt;b&gt;方向约定&lt;/b&gt;：&lt;br&gt;W → Y +1　S → Y -1&lt;br&gt;D → X +1　A → X -1&lt;br&gt;&lt;b&gt;关键 Modifier&lt;/b&gt;：Negate / 轴向转换&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：二维移动候选值" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="340" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-03" value="&lt;b&gt;I3. Enhanced Input 修饰并合成 Axis2D&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：各键映射值&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：按 IMC 中的 Modifier 调整符号和分量，再将同时按下的键合成为 FVector2D&lt;br&gt;&lt;b&gt;示例&lt;/b&gt;：W + D → (1, 1)&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：FInputActionValue(Axis2D)&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;：归一化/限幅取决于资产中的 Modifier 配置" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="370" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-04" value="&lt;b&gt;I4. IA_Move 触发器求值&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;执行者&lt;/b&gt;：UEnhancedPlayerInput&lt;br&gt;&lt;b&gt;判断&lt;/b&gt;：动作当前值是否满足 Trigger 条件&lt;br&gt;&lt;b&gt;事件&lt;/b&gt;：绑定使用 ETriggerEvent::Triggered&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：本帧触发 IA_Move 回调，并携带 FInputActionValue&lt;br&gt;&lt;br&gt;&lt;b&gt;无有效输入&lt;/b&gt;：不会产生本次 Triggered 调用" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="370" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-05" value="&lt;b&gt;I5. ULyraInputComponent 分发绑定&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;初始化绑定来源&lt;/b&gt;：InputTag_Move → IA_Move → Input_Move&lt;br&gt;&lt;b&gt;执行&lt;/b&gt;：Enhanced Input 找到 IA_Move 对应的绑定句柄&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：调用 ULyraHeroComponent::Input_Move(InputActionValue)&lt;br&gt;&lt;br&gt;&lt;b&gt;设计意义&lt;/b&gt;：GameplayTag 将输入资产与角色 C++ 函数解耦" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="450" width="370" height="270" as="geometry" /></mxCell>
      <mxCell id="p2-06" value="&lt;b&gt;I6. ULyraHeroComponent::Input_Move&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;位置&lt;/b&gt;：Character/LyraHeroComponent.cpp:374&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：FInputActionValue&lt;br&gt;&lt;b&gt;校验&lt;/b&gt;：取得 Pawn 与 Controller&lt;br&gt;&lt;b&gt;转换&lt;/b&gt;：Value.Get&amp;lt;FVector2D&amp;gt;()&lt;br&gt;&lt;b&gt;附加行为&lt;/b&gt;：若 PlayerController 正在 AutoRun，则关闭 AutoRun&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：Value.X / Value.Y" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="450" width="370" height="270" as="geometry" /></mxCell>
      <mxCell id="p2-07" value="&lt;b&gt;I7. 以控制器 Yaw 计算世界方向&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：Controller-&amp;gt;GetControlRotation().Yaw&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：构造 (Pitch=0, Yaw, Roll=0) 的 MovementRotation&lt;br&gt;&lt;b&gt;方向&lt;/b&gt;：&lt;br&gt;RightDirection = Rotate(RightVector)&lt;br&gt;ForwardDirection = Rotate(ForwardVector)&lt;br&gt;&lt;b&gt;效果&lt;/b&gt;：WASD 相对镜头水平朝向移动，不受俯仰角影响" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="450" width="340" height="270" as="geometry" /></mxCell>
      <mxCell id="p2-08" value="&lt;b&gt;I8. APawn::AddMovementInput&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;调用 1&lt;/b&gt;：RightDirection × Value.X&lt;br&gt;&lt;b&gt;调用 2&lt;/b&gt;：ForwardDirection × Value.Y&lt;br&gt;&lt;b&gt;引擎位置&lt;/b&gt;：Engine/Private/Pawn.cpp:820&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：转交 PawnMovementComponent-&amp;gt;AddInputVector&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：本帧世界空间移动输入被累积&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;：这里仍不是直接修改 Actor 位置" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="320" height="270" as="geometry" /></mxCell>
      <mxCell id="p2-09" value="&lt;b&gt;I9. UPawnMovementComponent::AddInputVector&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;引擎位置&lt;/b&gt;：PawnMovementComponent.cpp:64&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：WorldDirection × ScaleValue&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：累加到 PendingInputVector&lt;br&gt;&lt;b&gt;判断&lt;/b&gt;：IsMoveInputIgnored() 时可忽略输入&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：等待 CharacterMovement Tick 消费" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="320" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-10" value="&lt;b&gt;I10. UCharacterMovementComponent::TickComponent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;引擎位置&lt;/b&gt;：CharacterMovementComponent.cpp:1650&lt;br&gt;&lt;b&gt;执行&lt;/b&gt;：ConsumeInputVector()&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：取得并清空 PendingInputVector，形成当前帧 InputVector&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：传入 ControlledCharacterMove&lt;br&gt;&lt;br&gt;&lt;b&gt;关键点&lt;/b&gt;：输入采集与物理消费按帧解耦" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="800" width="340" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-11" value="&lt;b&gt;I11. ControlledCharacterMove&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;引擎位置&lt;/b&gt;：CharacterMovementComponent.cpp:6441&lt;br&gt;&lt;b&gt;输入&lt;/b&gt;：已消费的 InputVector、DeltaSeconds&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：约束/缩放输入，计算 Acceleration；结合跳跃等控制状态&lt;br&gt;&lt;b&gt;网络分支&lt;/b&gt;：&lt;br&gt;Authority/Standalone → PerformMovement&lt;br&gt;AutonomousProxy → ReplicateMoveToServer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="800" width="370" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-12" value="&lt;b&gt;I12. 物理与网络层输出最终移动&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;本地权威&lt;/b&gt;：PerformMovement → StartNewPhysics → PhysWalking → MoveAlongFloor&lt;br&gt;&lt;b&gt;自主客户端&lt;/b&gt;：本地预测并通过 ReplicateMoveToServer 提交移动&lt;br&gt;&lt;b&gt;碰撞处理&lt;/b&gt;：Sweep、StepUp、Slide&lt;br&gt;&lt;b&gt;最终输出&lt;/b&gt;：更新角色位置、Velocity 和网络移动状态&lt;br&gt;&lt;br&gt;&lt;b&gt;范围说明&lt;/b&gt;：此处开始属于 CharacterMovement 核心层" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="800" width="370" height="250" as="geometry" /></mxCell>
      <mxCell id="p2-note1" value="&lt;b&gt;输入系统核心数据流&lt;/b&gt;&lt;br&gt;&lt;br&gt;Key State → Mapping Context → InputAction Axis2D → Modifier/Trigger → FInputActionValue → GameplayTag 语义绑定 → C++ 回调 → World-space InputVector&lt;br&gt;&lt;br&gt;&lt;b&gt;最关键的 Lyra 扩展&lt;/b&gt;：ULyraInputConfig + ULyraInputComponent + ULyraHeroComponent 将 Enhanced Input 资产配置连接到角色逻辑。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="760" height="210" as="geometry" /></mxCell>
      <mxCell id="p2-note2" value="&lt;b&gt;关键条件与常见排查点&lt;/b&gt;&lt;br&gt;&lt;br&gt;① DefaultInput.ini 是否指定 ULyraInputComponent&lt;br&gt;② PawnData 是否引用正确 InputConfig&lt;br&gt;③ DefaultInputMappings 是否包含 IMC_Default 且优先级有效&lt;br&gt;④ InputConfig 是否存在 InputTag_Move → IA_Move&lt;br&gt;⑤ IA_Move 是否为 Axis2D，WASD Modifier 是否正确&lt;br&gt;⑥ HeroComponent 是否已进入输入初始化完成状态" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1120" width="760" height="210" as="geometry" /></mxCell>
      <mxCell id="p2-e01" value="I1 → I2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-01" target="p2-02"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p2-e02" value="I2 → I3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2-02" target="p2-03"><mxGeometry relative="1" as="geometry" /></mxCell>
