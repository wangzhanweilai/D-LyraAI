  <diagram id="lyra-camera-call-flow" name="相机输入、切换与视图调用链">
    <mxGraphModel dx="1212" dy="746" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="f0" />
        <mxCell id="f1" parent="f0" />
        <mxCell id="f-title" parent="f1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="Lyra Camera - Input, Mode Switching and View Evaluation" vertex="1">
          <mxGeometry height="45" width="2000" x="900" y="20" as="geometry" />
        </mxCell>
        <mxCell id="f-legend" parent="f1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="I = 输入绑定 | L = Look 输入 | A = Ability 模式覆盖 | D = 默认模式 | V = 每帧视图 | B = 模式混合 | F = FOV | W = 武器联动；编号表示同一功能路径中的直接调用顺序" vertex="1">
          <mxGeometry height="28" width="2850" x="480" y="70" as="geometry" />
        </mxCell>
        <mxCell id="f-note" parent="f1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;关键事实&lt;/b&gt;&lt;br&gt;Hero 的 Look 方法不直接移动相机，只写 Controller Rotation。相机模式每帧通过 Pawn.GetViewRotation() 读回该旋转；CameraComponent 再把混合后的 ControlRotation 写回 PlayerController，形成闭环。&lt;br&gt;&lt;br&gt;&lt;b&gt;缩放&lt;/b&gt;&lt;br&gt;没有 Hero Zoom 输入、滚轮距离缩放或 SpringArm 长度修改。缩放主要由不同 CameraMode 的 FieldOfView 与模式混合完成。AddFieldOfViewOffset 已实现但当前 C++ 无调用者。" vertex="1">
          <mxGeometry height="250" width="850" x="3380" y="130" as="geometry" />
        </mxCell>
        <mxCell id="flow-init" parent="f1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;resizeParent=1;resizeLast=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ULyraHeroComponent - 初始化" vertex="1">
          <mxGeometry height="190" width="660" x="80" y="140" as="geometry" />
        </mxCell>
        <mxCell id="flow-init-f" parent="flow-init" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="- PawnData / InputComponent / DefaultInputMappings" vertex="1">
          <mxGeometry height="26" width="660" y="26" as="geometry" />
        </mxCell>
        <mxCell id="flow-init-line" parent="flow-init" style="line;strokeWidth=1;fillColor=none;strokeColor=#82b366;" vertex="1">
          <mxGeometry height="8" width="660" y="52" as="geometry" />
        </mxCell>
        <mxCell id="flow-init-m-r1" parent="flow-init" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="I1 HandleChangeInitState(DataAvailable → DataInitialized)" vertex="1">
          <mxGeometry height="26" width="660" y="60" as="geometry" />
        </mxCell>
        <mxCell id="flow-init-m-r2" parent="flow-init" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="I2 InitializePlayerInput(InputComponent)" vertex="1">
          <mxGeometry height="26" width="660" y="86" as="geometry" />
        </mxCell>
        <mxCell id="flow-init-m-r3" parent="flow-init" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="I3 AddMappingContext / AddInputMappings" vertex="1">
          <mxGeometry height="26" width="660" y="112" as="geometry" />
        </mxCell>
        <mxCell id="flow-init-m-r4" parent="flow-init" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="I4 BindNativeAction(Look.Mouse / Look.Stick)" vertex="1">
          <mxGeometry height="26" width="660" y="138" as="geometry" />
        </mxCell>
        <mxCell id="flow-init-m-r5" parent="flow-init" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=5;whiteSpace=wrap;html=1;" value="I5 Camera.DetermineCameraModeDelegate.Bind(DetermineCameraMode)" vertex="1">
