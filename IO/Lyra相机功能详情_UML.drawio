        <mxCell id="c-title" parent="1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="LyraStarterGame Camera - Class Detail UML" vertex="1">
          <mxGeometry height="45" width="1800" x="1000" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c-legend" parent="1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="类框从上到下：类名 / 属性 / 方法 | 空心三角：继承 | 实心菱形：组合拥有 | 空心菱形：聚合/配置 | 虚线箭头：依赖或接口使用 | 绿色：已实现 | 黄色：资产/部分实现 | 灰色：UE 外部或预留" vertex="1">
          <mxGeometry height="28" width="2750" x="530" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;范围&lt;/b&gt;&lt;br&gt;覆盖 Source/LyraGame/Camera、LyraHeroComponent、LyraPawnData、LyraGameplayAbility，以及 ShooterCore Aim Assist 和 TopDownArena 相机模式。属性与方法严格分区；仅列与相机功能直接相关的成员。&lt;br&gt;&lt;br&gt;&lt;b&gt;实现边界&lt;/b&gt;&lt;br&gt;核心 CameraModeStack、第三人称跟随、防穿透、输入和 Ability 覆盖均为本地实现；未发现 Lyra 自定义相机网络同步。CM_ThirdPerson、ADS、Death 等为 uasset 配置。" vertex="1">
          <mxGeometry height="240" width="850" x="3540" y="120" as="geometry" />
        </mxCell>
