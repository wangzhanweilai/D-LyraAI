        <mxCell id="select-init" parent="select-widget" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ Initialize()：初次把 ViewTarget 指向 Tag=101" vertex="1">
          <mxGeometry height="26" width="680" y="112" as="geometry" />
