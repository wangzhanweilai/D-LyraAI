  <diagram id="px-lobby-sex-to-name-camera" name="性别选择到起名 - 相机切换流程">
    <mxGraphModel dx="1141" dy="667" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lobby-title" parent="1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="性别选择切换到起名 - 相机变化流程（方法级 UML）" vertex="1">
          <mxGeometry height="45" width="1900" x="760" y="20" as="geometry" />
        </mxCell>
        <mxCell id="lobby-legend" parent="1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="实线：实际直接调用 | 虚线：事件、资产轨道或条件性关系 | 黄色：需要在 Level Sequence 资产中确认的镜头轨道 | 本页没有服务器交互" vertex="1">
          <mxGeometry height="28" width="2180" x="620" y="70" as="geometry" />
        </mxCell>
        <mxCell id="lobby-notes" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;调用编号说明&lt;/b&gt;&lt;br&gt;&lt;b&gt;L&lt;/b&gt; = 选性别完成后切换起名展示区域 | &lt;b&gt;S&lt;/b&gt; = 完成切换时的 Level Sequence 播放 | &lt;b&gt;V&lt;/b&gt; = 起名 Widget 的 ViewTarget 固定流程。数字表示同一路径中的直接调用顺序。&lt;br&gt;&lt;br&gt;&lt;b&gt;为什么相机会变化&lt;/b&gt;&lt;br&gt;1. 点击完成的真实 C++ 路径只切换 UI 可见性、复位预览角色朝向并播放 FinishedSequence，&lt;b&gt;未直接调用 FixedCamera / SetViewTargetWithBlend&lt;/b&gt;。&lt;br&gt;2. 因此切换瞬间的可见镜头运动来自 FinishedSequence 中配置的 CameraActor 或对象 Transform 轨道；C++ 只负责创建并播放序列，具体轨道内容需打开资产确认。&lt;br&gt;3. UPXLobbyGiveNameWidget 初始化或 UPXLobbySubsystem.FixedCamera 被触发时，会将 ViewTarget 设为 Tag=101 的 Actor；若当前目标已经是该 Actor，只是重新固定目标，不一定产生可见位移。Map_Lobby.umap 中 ViewTarget 设置Tag为101。&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;关键事实&lt;/b&gt;：UPXLobbySelectSexWidget.GameNameWidget 的静态类型是 UUserWidget，源码没有证明它就是 UPXLobbyGiveNameWidget，也没有从 ShowGiveNameWidget 直接调用该类。图中以虚线表示“起名展示区域”与该类的资产/装配关系。" vertex="1">
          <mxGeometry height="330" width="900" x="2440" y="120" as="geometry" />
        </mxCell>
        <mxCell id="lua-select" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="PXLobbySelectSexWidget.lua &lt;font color=&quot;#008000&quot;&gt;UnLua 绑定&lt;/font&gt;" vertex="1">
          <mxGeometry height="112" width="580" x="80" y="160" as="geometry" />
        </mxCell>
        <mxCell id="lua-select-f" parent="lua-select" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="- FinishBtn.OnButtonBaseClicked 绑定" vertex="1">
          <mxGeometry height="26" width="580" y="26" as="geometry" />
        </mxCell>
        <mxCell id="lua-select-line" parent="lua-select" style="line;strokeWidth=1;fillColor=none;" value="" vertex="1">
          <mxGeometry height="8" width="580" y="52" as="geometry" />
        </mxCell>
        <mxCell id="lua-finish" parent="lua-select" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ OnClickedFinishBtn()：完成性别选择" vertex="1">
          <mxGeometry height="26" width="580" y="60" as="geometry" />
        </mxCell>
        <mxCell id="lua-call-name" parent="lua-select" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ self:ShowGiveNameWidget()" vertex="1">
          <mxGeometry height="26" width="580" y="86" as="geometry" />
        </mxCell>
        <mxCell id="select-widget" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="UPXLobbySelectSexWidget &lt;font color=&quot;#008000&quot;&gt;PXLobby C++&lt;/font&gt;" vertex="1">
          <mxGeometry height="216" width="680" x="820" y="140" as="geometry" />
        </mxCell>
        <mxCell id="select-f" parent="select-widget" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="- GameNameWidget : UUserWidget&lt;br&gt;- SelectedSexWidget : UPanelWidget&lt;br&gt;- CurModelPawn / InitialRotation / FinishedSequence" vertex="1">
          <mxGeometry height="52" width="680" y="26" as="geometry" />
        </mxCell>
        <mxCell id="select-line" parent="select-widget" style="line;strokeWidth=1;fillColor=none;" value="" vertex="1">
          <mxGeometry height="8" width="680" y="78" as="geometry" />
        </mxCell>
        <mxCell id="select-show-name" parent="select-widget" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ ShowGiveNameWidget()：切换区域并启动完成序列" vertex="1">
          <mxGeometry height="26" width="680" y="86" as="geometry" />
