          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-v2" edge="1" parent="1" source="style-view-target" style="endArrow=open;endFill=0;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontColor=#666666;" target="view-hook-method" value="V2：调用可覆写 OnSetViewTarget；基类无默认实现">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1600" y="530" />
              <mxPoint x="1600" y="760" />
