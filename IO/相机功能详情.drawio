  <diagram id="px-camera-style-detail" name="UPXCameraStyle 功能点与调用流程">
    <mxGraphModel dx="1968" dy="1836" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="style-title" parent="1" style="text;html=1;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" value="UPXCameraStyle 功能点与调用流程" vertex="1">
          <mxGeometry height="45" width="2000" x="720" y="20" as="geometry" />
        </mxCell>
        <mxCell id="style-legend" parent="1" style="text;html=1;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;" value="实线：源码中的直接调用 | 虚线：条件、返回或延后状态 | 编号前缀：S=激活/过渡，D=失活/结束，M=Modifier 管理，T=逐帧更新，V=视角目标 | 本页仅描述本地对象协作，不使用服务端蓝色" vertex="1">
          <mxGeometry height="26" width="3000" x="250" y="70" as="geometry" />
        </mxCell>
        <mxCell id="style-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="&lt;b&gt;功能点&lt;/b&gt;&lt;br&gt;1. 样式队列：StyleManager 按 Tag、优先级与取消规则维护 ActivatedStyles，并选择下一活动样式。&lt;br&gt;2. 生命周期：Style 依次经历 Idle → Start → Active → Deactive → End；过渡完成才推进 Start/Deactive 的后续通知。&lt;br&gt;3. Modifier：Style 负责创建、Tag 冲突处理、优先级排序、激活、失活、延后回收与逐帧合成。&lt;br&gt;4. 过渡与回调：Transition/Modifier 通过 Handle 查回所属 Style，完成 Blend 后驱动状态机。&lt;br&gt;5. SetViewTarget 仅委派给子类/蓝图 OnSetViewTarget；基类默认不修改 ViewTarget。&lt;br&gt;&lt;br&gt;&lt;b&gt;边界&lt;/b&gt;&lt;br&gt;省略 Unreal 原生 Tick、对象创建及视图渲染内部，仅保留 PXCamera 层的入口与关系端点。" vertex="1">
          <mxGeometry height="330" width="940" x="2340" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sm" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="UPXCameraStyleManager" vertex="1">
          <mxGeometry height="252" width="610" x="-115" y="59" as="geometry" />
        </mxCell>
        <mxCell id="sm-activate" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ ActivateCameraStyle(Parm)：校验、Tag/优先级仲裁、入队" vertex="1">
          <mxGeometry height="26" width="610" y="28" as="geometry" />
        </mxCell>
        <mxCell id="sm-start" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ StartCameraStyle(Handle)：设置 CurrentActiveStyleHandle" vertex="1">
          <mxGeometry height="26" width="610" y="54" as="geometry" />
        </mxCell>
        <mxCell id="sm-deactivate" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ DeactivateCameraStyle(Param) / DeactiveActiveStyle()" vertex="1">
          <mxGeometry height="26" width="610" y="80" as="geometry" />
        </mxCell>
        <mxCell id="sm-started" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ StyleStartedNotify(Handle)：过渡入场完成后激活 Style" vertex="1">
          <mxGeometry height="26" width="610" y="106" as="geometry" />
        </mxCell>
        <mxCell id="sm-deactivated" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ StyleDeactivatedNotify(Handle)：调用 Style.End()" vertex="1">
          <mxGeometry height="26" width="610" y="132" as="geometry" />
        </mxCell>
        <mxCell id="sm-ended" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ StyleEndNotify(Handle)：复用 Idle 或 Destroy，并尝试下一个" vertex="1">
          <mxGeometry height="26" width="610" y="158" as="geometry" />
        </mxCell>
        <mxCell id="sm-destroy" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ DestroyStyle(Handle) / TryStartNextStyle()" vertex="1">
          <mxGeometry height="26" width="610" y="184" as="geometry" />
        </mxCell>
        <mxCell id="sm-end" parent="sm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontColor=#666666;" value="ActivatedStyles / StyleMap：查找当前 Style、判定 Tag/优先级/取消规则" vertex="1">
          <mxGeometry height="42" width="610" y="210" as="geometry" />
        </mxCell>
        <mxCell id="style" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="UPXCameraStyle：状态机、上下文与 Modifier 队列 Owner" vertex="1">
          <mxGeometry height="470" width="850" x="730" y="130" as="geometry" />
        </mxCell>
        <mxCell id="style-ready" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ ReadyForNextActive()：设 Idle，重置 Transition/Modifier" vertex="1">
          <mxGeometry height="26" width="850" y="28" as="geometry" />
        </mxCell>
        <mxCell id="style-start" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ Start()：Reset Context，状态=Start，准备 BlendIn 过渡" vertex="1">
          <mxGeometry height="26" width="850" y="54" as="geometry" />
        </mxCell>
        <mxCell id="style-ensure-transition" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ EnsureTransition()：按 DataID 创建/取得 Transition 并 Initialize" vertex="1">
          <mxGeometry height="26" width="850" y="80" as="geometry" />
