        <mxCell id="style-active" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ Active()：CaptureCamera，ApplyModifiers，状态=Active" vertex="1">
          <mxGeometry height="26" width="850" y="106" as="geometry" />
        </mxCell>
        <mxCell id="style-deactive" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ Deactive(Params)：状态准备 BlendOut，DeactiveModifiers" vertex="1">
          <mxGeometry height="26" width="850" y="132" as="geometry" />
        </mxCell>
        <mxCell id="style-end-life" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ End()：Restore CachedInfo，状态=End，通知 Manager" vertex="1">
          <mxGeometry height="26" width="850" y="158" as="geometry" />
        </mxCell>
        <mxCell id="style-transition-finish" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ TransitionFinishNotify()：Start→Started 或 Deactive→Deactivated" vertex="1">
          <mxGeometry height="26" width="850" y="184" as="geometry" />
        </mxCell>
        <mxCell id="style-tick" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ Tick()：Transition.Update（若处于过渡）+ UpdateModifiers" vertex="1">
          <mxGeometry height="26" width="850" y="210" as="geometry" />
        </mxCell>
        <mxCell id="style-notified" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;" value="+ NotifiedByModifier()：判定 Blend 结束，推进状态/延后回收" vertex="1">
          <mxGeometry height="26" width="850" y="236" as="geometry" />
        </mxCell>
        <mxCell id="style-add" parent="style" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;html=1;fontStyle=1;" value="+ AddModifier()：创建、Tag 冲突/唯一性、按优先级插入" vertex="1">
          <mxGeometry height="26" width="850" y="262" as="geometry" />
