        <mxCell id="e-s11" edge="1" parent="1" source="sm-started" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" target="style-active" value="S11：Manager 令 Style 进入 Active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s12" edge="1" parent="1" source="style-active" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" target="style-active-mod" value="S12：激活已有 Modifier 并应用初始效果">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d1" edge="1" parent="1" source="sm-deactivate" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="sm-end" value="D1：定位当前活动 Style 并计算失活规则">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d2" edge="1" parent="1" source="sm-deactivate" style="endArrow=block;endFill=1;html=1;edgeStyle=entityRelationEdgeStyle;rounded=0;strokeColor=#b85450;" target="style-deactive" value="D2：传入 Ignore Blend/EndType 等参数">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d3" edge="1" parent="1" source="style-deactive" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="modifier-deactive" value="D3：对所有 Modifier 标记并开始失活">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d4" edge="1" parent="1" source="modifier-notify" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="style-notified" value="D4：BlendOut 完成后回报所属 Style">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d5" edge="1" parent="1" source="style-notified" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="transition-receive" value="D5：全部结束后准备 Transition BlendOut">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d6" edge="1" parent="1" source="style-transition-finish" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="sm-deactivated" value="D6：过渡完成再通知 Deactivated">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d7" edge="1" parent="1" source="sm-deactivated" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="style-end-life" value="D7：完整失活后恢复缓存相机信息">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d8" edge="1" parent="1" source="style-end-life" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="sm-ended" value="D8：End 后由 Manager 决定复用或销毁">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d9" edge="1" parent="1" source="sm-ended" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="style-ready" value="D9：IdleAfterEnd 时复位；DestroyAfterEnd 时销毁">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-d10" edge="1" parent="1" source="sm-destroy" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;" target="pool-unregister" value="D10：销毁时从对象池注销 Handle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m1" edge="1" parent="1" source="runtime-modifier" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="style-add" value="M1：业务请求向 Style 添加 Modifier">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m2" edge="1" parent="1" source="style-add" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="cm-modifier" value="M2：按 ModifierDataID 创建对象">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m3" edge="1" parent="1" source="cm-modifier" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="pool-find" value="M3：由 Handle 查回新 Modifier">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m4" edge="1" parent="1" source="pool-find" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="modifier-init" value="M4：初始化并绑定 OwnerStyle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m5" edge="1" parent="1" source="modifier-init" style="endArrow=open;endFill=0;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontColor=#666666;" target="style-add" value="M5：通过 Blocked/Remove/Unique 后按优先级插入">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m6" edge="1" parent="1" source="style-active-mod" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="modifier-active" value="M6：Style 显式/批量激活队列中的效果">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m7" edge="1" parent="1" source="style-remove" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="modifier-deactive" value="M7：需要退出时先失活，必要时加入 PendingRemove">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m8" edge="1" parent="1" source="style-notified" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="style-remove" value="M8：BlendOut 回调后以 NeedDeactive=false 实际回收">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-m9" edge="1" parent="1" source="style-remove" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;" target="pool-unregister" value="M9：从队列删除、对象池注销并标记垃圾">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-t1" edge="1" parent="1" source="runtime-tick" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;" target="style-tick" value="T1：运行时每帧进入 Style.Tick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-t2" edge="1" parent="1" source="style-tick" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;" target="transition-update" value="T2：过渡中才 Update Transition">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-t3" edge="1" parent="1" source="style-tick" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;" target="modifier-update" value="T3：反向遍历已启用 Modifier 并更新">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-t4" edge="1" parent="1" source="modifier-update" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;" target="modifier-notify" value="T4：Alpha 变化才发出 Blend 状态通知">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-t5" edge="1" parent="1" source="modifier-notify" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;" target="transition-notify" value="T5：同时通知 Transition 与 Style，驱动后续状态">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
