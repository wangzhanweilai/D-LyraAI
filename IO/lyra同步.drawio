<mxfile host="Electron" pages="2">
  <diagram name="第 1 页" id="wTrQT3GwYAQnNFJkoOsa">
    <mxGraphModel dx="17623" dy="12065" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="DDktz6_lc9Rk2UhdFB5B-2" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;void UCharacterMovementComponent::PerformMovement(float DeltaSeconds)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 前置检查&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (!HasValidData() || DeltaSeconds &amp;lt;= 0.f)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 处理根运动 (Root Motion)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; bool bHasRootMotion = false;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FVector RootMotionTranslation;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FRotator RootMotionRotation;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (ShouldUseRootMotion())&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 从动画实例中提取根运动数据&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ExtractRootMotionFromAnimation(RootMotionTranslation, RootMotionRotation);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; bHasRootMotion = true;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 应用根运动旋转&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ApplyRootMotionRotation(RootMotionRotation);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 根据移动模式执行物理模拟&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // StartNewPhysics 会根据 MovementMode 调用具体的 PhysWalking, PhysFalling 等&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; StartNewPhysics(DeltaSeconds, 0);&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 在 PhysWalking 等函数内部，会执行：&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // - MoveAlongFloor (包含 Sweep, StepUp, Slide)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // - 应用重力&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // - 更新 Velocity&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 4. 如果有根运动位移，额外应用&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (bHasRootMotion)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 将根运动的位移叠加到最终位置上，或用于修正速度&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ApplyRootMotionTranslation(RootMotionTranslation);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 5. 网络同步逻辑&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (Role == ROLE_AutonomousProxy)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 客户端：保存移动数据，发送 ServerMove RPC&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SaveMovedPosition();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SendServerMovePacket();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else if (Role == ROLE_Authority)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 服务器：复制移动状态给其他客户端&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ReplicateMovementToClients();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else if (Role == ROLE_SimulatedProxy)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 模拟代理：通常不在 PerformMovement 中做复杂物理计算，&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 而是通过 OnRep_ReplicatedMovement 进行插值&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 6. 更新地板状态和触发事件&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UpdateFloorFromAdjustment();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; OnMovementUpdated.Broadcast(DeltaSeconds, OldLocation, OldVelocity);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="910" width="490" x="-5159" y="50" as="geometry" />
        </mxCell>
        <mxCell id="DDktz6_lc9Rk2UhdFB5B-3" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;void UCharacterMovementComponent::StartNewPhysics(float deltaTime, int32 iterations)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (deltaTime &amp;lt;= 0.f || iterations &amp;gt; MaxSimulationIterations)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 根据当前移动模式调用对应的 Phys 函数&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; switch (MovementMode)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Walking:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysWalking(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Falling:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysFalling(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Swimming:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysSwimming(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Custom:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysCustom(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // ... 其他模式&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="500" x="-4320" y="-240" as="geometry" />
        </mxCell>
        <mxCell id="DDktz6_lc9Rk2UhdFB5B-4" edge="1" parent="1" source="DDktz6_lc9Rk2UhdFB5B-2" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1.003;exitY=0.401;exitDx=0;exitDy=0;exitPerimeter=0;" target="DDktz6_lc9Rk2UhdFB5B-3" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="-4300" y="300" as="sourcePoint" />
            <mxPoint x="-4140" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DDktz6_lc9Rk2UhdFB5B-5" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;void UCharacterMovementComponent::PhysWalking(float deltaTime, int32 iterations)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 计算期望速度：结合当前速度、加速度、摩擦力&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 计算期望位移：Velocity * DeltaTime&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 执行 Sweep (碰撞扫描)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp; - MoveAlongFloor: 尝试沿地面移动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp; - 如果撞到墙：计算 Slide Vector，沿墙滑动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp; - 如果撞到斜坡：尝试 StepUp (爬坡)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 伪代码逻辑：&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FVector Adjusted = MoveAlongFloor(Velocity, deltaTime, &amp;amp;HitResult);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (HitResult.bBlockingHit)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 处理碰撞响应：滑动或停止&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; HandleImpact(HitResult, deltaTime, Adjusted);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 尝试爬坡&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (CanStepUp(HitResult))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; StepUp(HitResult.Normal, HitResult.ImpactPoint, Adjusted);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 更新最终位置和速度&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UpdateComponentPosition();&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="470" x="-3620" y="-470" as="geometry" />
        </mxCell>
        <mxCell id="DDktz6_lc9Rk2UhdFB5B-6" edge="1" parent="1" source="DDktz6_lc9Rk2UhdFB5B-3" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1.002;exitY=0.404;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="DDktz6_lc9Rk2UhdFB5B-5" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="-3730" y="-20" as="sourcePoint" />
            <mxPoint x="-3570" y="-20" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DDktz6_lc9Rk2UhdFB5B-7" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;环境准备‌：检查有效性，保存旧状态。&lt;/div&gt;&lt;div&gt;根运动预处理‌：提取动画驱动的位移。&lt;/div&gt;&lt;div&gt;网络分派‌：&lt;/div&gt;&lt;div&gt;SimulatedProxy‌：转为 SimulateMovement 进行插值。&lt;/div&gt;&lt;div&gt;AutonomousProxy‌：加载本地预测输入。&lt;/div&gt;&lt;div&gt;Authority‌：使用权威输入。&lt;/div&gt;&lt;div&gt;物理核心‌：调用 StartNewPhysics -&amp;gt; PhysWalking/Falling/etc 执行具体的碰撞检测、速度积分和位置更新。&lt;/div&gt;&lt;div&gt;根运动后处理‌：叠加动画位移。&lt;/div&gt;&lt;div&gt;网络同步‌：&lt;/div&gt;&lt;div&gt;AutonomousProxy‌：保存状态并发送 ServerMove RPC。&lt;/div&gt;&lt;div&gt;Authority‌：准备复制数据给客户端。&lt;/div&gt;&lt;div&gt;事件广播‌：通知游戏逻辑层移动已完成。&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="590" x="-5040" y="-1190" as="geometry" />
        </mxCell>
        <mxCell id="DDktz6_lc9Rk2UhdFB5B-8" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;`// 角色移动系统核心函数，每帧调用一次，负责处理所有移动物理计算、根运动、网络同步和状态更新`\&lt;/div&gt;&lt;div&gt;`void UCharacterMovementComponent::PerformMovement(float DeltaSeconds)`\&lt;/div&gt;&lt;div&gt;`{`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 性能统计：标记该函数执行时间用于Profiler分析`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; SCOPE_CYCLE_COUNTER(STAT_CharacterMovementPerformMovement);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if UE_WITH_REMOTE_OBJECT_HANDLE &amp;amp;&amp;amp; UE_AUTORTFM`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 自动事务内存优化：假设移动期间只碰撞静态几何体，避免跨服务器推测执行的开销`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; UE::RemoteExecutor::FSpeculationExecutionScope AssumeNoCrossServerHits;`\&lt;/div&gt;&lt;div&gt;`#endif`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 获取世界上下文并检查数据有效性`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; const UWorld* MyWorld = GetWorld();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; if (!HasValidData() || MyWorld == nullptr)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return; // 数据无效时直接返回，避免崩溃`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 检测角色是否在上次更新后发生了传送（例如复活时传送到重生点）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; bTeleportedSinceLastUpdate = UpdatedComponent-&amp;gt;GetComponentLocation() != LastUpdateLocation;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; `\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 如果移动模式为None、组件不可移动或正在物理模拟，则跳过移动逻辑`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; if (MovementMode == MOVE_None || UpdatedComponent-&amp;gt;Mobility != EComponentMobility::Movable || UpdatedComponent-&amp;gt;IsSimulatingPhysics())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 仅在非客户端更新且不忽略根运动时处理根运动消耗`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (!CharacterOwner-&amp;gt;bClientUpdating &amp;amp;&amp;amp; !CharacterOwner-&amp;gt;bServerMoveIgnoreRootMotion)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 消耗动画根运动：即使不移动也要Tick动画姿态`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (CharacterOwner-&amp;gt;IsPlayingRootMotion() &amp;amp;&amp;amp; CharacterOwner-&amp;gt;GetMesh())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; TickCharacterPose(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionParams.Clear(); // 清空动画根运动参数`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 清空其他根运动源（如GAS技能触发的根运动）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (CurrentRootMotion.HasActiveRootMotionSources())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CurrentRootMotion.Clear();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 清除所有累积的物理力（如LaunchCharacter的弹射力）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ClearAccumulatedForces();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return; // 跳过后续所有移动逻辑`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 如果角色在地面移动且发生了传送，强制下一帧检查地面（防止传送后卡在地里）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; bForceNextFloorCheck |= (IsMovingOnGround() &amp;amp;&amp;amp; bTeleportedSinceLastUpdate);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 更新叠加型根运动的速度基准值`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 关键点：GAS技能中的AdditiveVelocity根运动需要正确累加外部速度变化`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; if( CurrentRootMotion.HasAdditiveVelocity() )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector Adjustment = (Velocity - LastUpdateVelocity);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CurrentRootMotion.LastPreAdditiveVelocity += Adjustment; // 累积速度变化到基准值`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if ROOT_MOTION_DEBUG`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 调试信息：显示叠加速度调整`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (RootMotionSourceDebug::CVarDebugRootMotionSources.GetValueOnGameThread() == 1)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (!Adjustment.IsNearlyZero())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FString AdjustedDebugString = FString::Printf(TEXT(&quot;PerformMovement HasAdditiveVelocity LastUpdateVelocityAdjustment LastPreAdditiveVelocity(%s) Adjustment(%s)&quot;),`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *CurrentRootMotion.LastPreAdditiveVelocity.ToCompactString(), *Adjustment.ToCompactString());`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionSourceDebug::PrintOnScreen(*CharacterOwner, AdjustedDebugString);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`#endif`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 保存移动前的速度和位置，用于后续计算和网络同步`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; FVector OldVelocity;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; FVector OldLocation;`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 使用作用域胶囊体移动更新，优化多次MoveComponent调用的性能`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 重要：这减少了不必要的碰撞检测开销，在复杂移动场景下性能提升明显`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FScopedCapsuleMovementUpdate ScopedMovementUpdate(UpdatedComponent, bEnableScopedMovementUpdates);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 更新基于物体的移动（如站在移动平台上）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; MaybeUpdateBasedMovement(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 清理无效的根运动源（包括自然结束的根运动）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 注意：必须在ApplyAccumulatedForces之前清理，因为根运动源可能包含速度限制或覆盖逻辑`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const bool bHasRootMotionSources = HasRootMotionSources();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (bHasRootMotionSources &amp;amp;&amp;amp; !CharacterOwner-&amp;gt;bClientUpdating &amp;amp;&amp;amp; !CharacterOwner-&amp;gt;bServerMoveIgnoreRootMotion)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SCOPE_CYCLE_COUNTER(STAT_CharacterMovementRootMotionSourceCalculate);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector VelocityBeforeCleanup = Velocity;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CurrentRootMotion.CleanUpInvalidRootMotion(DeltaSeconds, *CharacterOwner, *this);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if ROOT_MOTION_DEBUG`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 调试：显示清理根运动源后的速度变化`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (RootMotionSourceDebug::CVarDebugRootMotionSources.GetValueOnGameThread() == 1)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (Velocity != VelocityBeforeCleanup)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector Adjustment = Velocity - VelocityBeforeCleanup;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FString AdjustedDebugString = FString::Printf(TEXT(&quot;PerformMovement CleanUpInvalidRootMotion Velocity(%s) VelocityBeforeCleanup(%s) Adjustment(%s)&quot;),`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *Velocity.ToCompactString(), *VelocityBeforeCleanup.ToCompactString(), *Adjustment.ToCompactString());`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionSourceDebug::PrintOnScreen(*CharacterOwner, AdjustedDebugString);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`#endif`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 保存移动前的状态`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OldVelocity = Velocity;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OldLocation = UpdatedComponent-&amp;gt;GetComponentLocation();`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 应用累积的物理力（如重力、弹射力等）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ApplyAccumulatedForces(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 在移动前更新角色状态（如蹲伏、攀爬等）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; UpdateCharacterStateBeforeMovement(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 导航移动模式特殊处理：如果角色想要离开导航移动，尝试切换到普通移动`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (MovementMode == MOVE_NavWalking &amp;amp;&amp;amp; bWantsToLeaveNavWalking)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; TryToLeaveNavWalking();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 处理之前缓存的弹射请求（LaunchCharacter的延迟执行）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 关键点：GAS技能中的LaunchCharacter调用在这里生效`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; HandlePendingLaunch();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ClearAccumulatedForces(); // 清空已处理的累积力`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if ROOT_MOTION_DEBUG`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 调试：显示应用物理力后的速度变化`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (RootMotionSourceDebug::CVarDebugRootMotionSources.GetValueOnGameThread() == 1)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (OldVelocity != Velocity)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector Adjustment = Velocity - OldVelocity;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FString AdjustedDebugString = FString::Printf(TEXT(&quot;PerformMovement ApplyAccumulatedForces+HandlePendingLaunch Velocity(%s) OldVelocity(%s) Adjustment(%s)&quot;),`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *Velocity.ToCompactString(), *OldVelocity.ToCompactString(), *Adjustment.ToCompactString());`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionSourceDebug::PrintOnScreen(*CharacterOwner, AdjustedDebugString);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`#endif`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 更新叠加型根运动的速度基准值（考虑物理力影响后的变化）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( CurrentRootMotion.HasAdditiveVelocity() )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector Adjustment = (Velocity - OldVelocity);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CurrentRootMotion.LastPreAdditiveVelocity += Adjustment;`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if ROOT_MOTION_DEBUG`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (RootMotionSourceDebug::CVarDebugRootMotionSources.GetValueOnGameThread() == 1)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (!Adjustment.IsNearlyZero())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FString AdjustedDebugString = FString::Printf(TEXT(&quot;PerformMovement HasAdditiveVelocity AccumulatedForces LastPreAdditiveVelocity(%s) Adjustment(%s)&quot;),`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *CurrentRootMotion.LastPreAdditiveVelocity.ToCompactString(), *Adjustment.ToCompactString());`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionSourceDebug::PrintOnScreen(*CharacterOwner, AdjustedDebugString);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`#endif`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 准备根运动数据（从动画和其他根运动源生成/累积）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 注意：客户端更新时跳过，避免重复计算`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (bHasRootMotionSources &amp;amp;&amp;amp; !CharacterOwner-&amp;gt;bClientUpdating &amp;amp;&amp;amp; !CharacterOwner-&amp;gt;bServerMoveIgnoreRootMotion)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 动画根运动：如果使用动画根运动，先Tick动画姿态`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( CharacterOwner-&amp;gt;IsPlayingRootMotion() &amp;amp;&amp;amp; CharacterOwner-&amp;gt;GetMesh() )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; TickCharacterPose(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 检查动画事件是否销毁了角色（安全保护）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (!HasValidData())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 网络同步关键：本地自治代理客户端保存根运动数据，用于客户端预测和服务器校正`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( CharacterOwner-&amp;gt;IsLocallyControlled() &amp;amp;&amp;amp; (CharacterOwner-&amp;gt;GetLocalRole() == ROLE_AutonomousProxy) &amp;amp;&amp;amp; CharacterOwner-&amp;gt;IsPlayingNetworkedRootMotionMontage() )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CharacterOwner-&amp;gt;ClientRootMotionParams = RootMotionParams; // 缓存给网络同步使用`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 生成非动画根运动源的数据（如GAS技能创建的根运动）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SCOPE_CYCLE_COUNTER(STAT_CharacterMovementRootMotionSourceCalculate);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CurrentRootMotion.PrepareRootMotion(DeltaSeconds, *CharacterOwner, *this, true);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 保存根运动数据用于网络同步`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( CharacterOwner-&amp;gt;IsLocallyControlled() &amp;amp;&amp;amp; (CharacterOwner-&amp;gt;GetLocalRole() == ROLE_AutonomousProxy) )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CharacterOwner-&amp;gt;SavedRootMotion = CurrentRootMotion;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 将根运动应用到速度`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 重要：动画根运动优先级最高，会覆盖其他所有根运动源`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( CurrentRootMotion.HasOverrideVelocity() || HasAnimRootMotion() )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( HasAnimRootMotion() ) // 动画根运动处理`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 将局部空间根运动转换为世界空间`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; USkeletalMeshComponent * SkelMeshComp = CharacterOwner-&amp;gt;GetMesh();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( SkelMeshComp )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 关键：在物理计算前转换，确保使用最新的变换`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionParams.Set( ConvertLocalRootMotionToWorld(RootMotionParams.GetRootMotionTransform(), DeltaSeconds) );`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 将根运动位移转换为速度，用于物理模式计算`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( DeltaSeconds &amp;gt; 0.f )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; AnimRootMotionVelocity = CalcAnimRootMotionVelocity(RootMotionParams.GetRootMotionTransform().GetTranslation(), DeltaSeconds, Velocity);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Velocity = ConstrainAnimRootMotionVelocity(AnimRootMotionVelocity, Velocity);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; `\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 特殊处理：下落状态时保留之前地面的XY速度（防止根运动中断滑翔等效果）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (IsFalling())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Velocity += FVector(DecayingFormerBaseVelocity.X, DecayingFormerBaseVelocity.Y, 0.f);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; `\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 日志输出：用于调试根运动效果`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; UE_LOGF(LogRootMotion, Log,&amp;nbsp; &quot;PerformMovement WorldSpaceRootMotion Translation: %ls, Rotation: %ls, Actor Facing: %ls, Velocity: %ls&quot;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; , *RootMotionParams.GetRootMotionTransform().GetTranslation().ToCompactString()`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; , *RootMotionParams.GetRootMotionTransform().GetRotation().Rotator().ToCompactString()`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; , *CharacterOwner-&amp;gt;GetActorForwardVector().ToCompactString()`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; , *Velocity.ToCompactString()`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; );`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; else // 非动画根运动源处理（如GAS技能）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( DeltaSeconds &amp;gt; 0.f )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SCOPE_CYCLE_COUNTER(STAT_CharacterMovementRootMotionSourceApply);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector VelocityBeforeOverride = Velocity;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FVector NewVelocity = Velocity;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 累积所有覆盖型根运动源的速度`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CurrentRootMotion.AccumulateOverrideRootMotionVelocity(DeltaSeconds, *CharacterOwner, *this, NewVelocity);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; `\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 下落状态特殊处理`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (IsFalling())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; NewVelocity += CurrentRootMotion.HasOverrideVelocityWithIgnoreZAccumulate() ? `\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FVector(DecayingFormerBaseVelocity.X, DecayingFormerBaseVelocity.Y, 0.f) : DecayingFormerBaseVelocity;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Velocity = NewVelocity;`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if ROOT_MOTION_DEBUG`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 调试：显示根运动覆盖后的速度变化`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (RootMotionSourceDebug::CVarDebugRootMotionSources.GetValueOnGameThread() == 1)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (VelocityBeforeOverride != Velocity)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FString AdjustedDebugString = FString::Printf(TEXT(&quot;PerformMovement AccumulateOverrideRootMotionVelocity Velocity(%s) VelocityBeforeOverride(%s)&quot;),`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *Velocity.ToCompactString(), *VelocityBeforeOverride.ToCompactString());`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionSourceDebug::PrintOnScreen(*CharacterOwner, AdjustedDebugString);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`#endif`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if ROOT_MOTION_DEBUG`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 调试：显示应用根运动后的最终速度`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (RootMotionSourceDebug::CVarDebugRootMotionSources.GetValueOnGameThread() == 1)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FString AdjustedDebugString = FString::Printf(TEXT(&quot;PerformMovement Velocity(%s) OldVelocity(%s)&quot;),`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *Velocity.ToCompactString(), *OldVelocity.ToCompactString());`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionSourceDebug::PrintOnScreen(*CharacterOwner, AdjustedDebugString);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`#endif`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // NaN值检测：确保速度没有非法值，避免物理系统崩溃`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; devCode(ensureMsgf(!Velocity.ContainsNaN(), TEXT(&quot;UCharacterMovementComponent::PerformMovement: Velocity contains NaN (%s)\n%s&quot;), *GetPathNameSafe(this), *Velocity.ToString()));`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 清空跳跃输入，为下一帧跳跃准备`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CharacterOwner-&amp;gt;ClearJumpInput(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; NumJumpApexAttempts = 0; // 重置跳跃顶点尝试次数`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 移动前最后一次机会更新速度（用户自定义扩展点）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; UpdateVelocityBeforeMovement(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; `\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 核心物理位置变更：根据移动模式调用对应的物理函数`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 注意：这里会处理碰撞、滑墙、爬台阶等所有物理交互`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; StartNewPhysics(DeltaSeconds, 0);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 再次检查数据有效性（物理计算可能触发销毁）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (!HasValidData())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 根据移动结果更新角色状态（如是否落地、是否开始下落等）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; UpdateCharacterStateAfterMovement(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 物理旋转：根据速度/加速度更新角色朝向`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 可配置是否允许在动画根运动期间进行物理旋转`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (bAllowPhysicsRotationDuringAnimRootMotion || !HasAnimRootMotion())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysicsRotation(DeltaSeconds);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 应用根运动旋转（在物理移动完成后）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( HasAnimRootMotion() )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FQuat OldActorRotationQuat = UpdatedComponent-&amp;gt;GetComponentQuat();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FQuat RootMotionRotationQuat = RootMotionParams.GetRootMotionTransform().GetRotation();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if( !RootMotionRotationQuat.IsIdentity() )`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FQuat NewActorRotationQuat = RootMotionRotationQuat * OldActorRotationQuat;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; MoveUpdatedComponent(FVector::ZeroVector, NewActorRotationQuat, true);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`#if !(UE_BUILD_SHIPPING)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 调试代码（默认禁用）：显示根运动位移和旋转的详细信息`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; #if 0`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FRotator OldActorRotation = OldActorRotationQuat.Rotator();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector ResultingLocation = UpdatedComponent-&amp;gt;GetComponentLocation();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FRotator ResultingRotation = UpdatedComponent-&amp;gt;GetComponentRotation();`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 显示当前位置坐标系`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; DrawDebugCoordinateSystem(MyWorld, CharacterOwner-&amp;gt;GetMesh()-&amp;gt;GetComponentLocation() + FVector(0,0,1), ResultingRotation, 50.f, false);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 显示位移向量`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; DrawDebugLine(MyWorld, OldLocation, ResultingLocation, FColor::Red, false, 10.f);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FMovementBaseInterfaceData* MovementBaseInterfaceData = GetMovementBaseInterfaceData();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 日志输出详细信息`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; UE_LOGF(LogRootMotion, Warning,&amp;nbsp; &quot;PerformMovement Resulting DeltaMove Translation: %ls, Rotation: %ls, MovementBase: %ls&quot;,`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *(ResultingLocation - OldLocation).ToCompactString(), *(ResultingRotation - OldActorRotation).GetNormalized().ToCompactString(), *GetNameSafe(MovementBaseInterfaceData ? MovementBaseInterfaceData-&amp;gt;GetMovementBaseObject() : nullptr));`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FVector RMTranslation = RootMotionParams.GetRootMotionTransform().GetTranslation();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FRotator RMRotation = RootMotionParams.GetRootMotionTransform().GetRotation().Rotator();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; UE_LOGF(LogRootMotion, Warning,&amp;nbsp; &quot;PerformMovement Resulting DeltaError Translation: %ls, Rotation: %ls&quot;,`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *(ResultingLocation - OldLocation - RMTranslation).ToCompactString(), *(ResultingRotation - OldActorRotation - RMRotation).GetNormalized().ToCompactString() );`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; #endif`\&lt;/div&gt;&lt;div&gt;`#endif // !(UE_BUILD_SHIPPING)`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 清空已使用的根运动参数`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RootMotionParams.Clear();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; else if (CurrentRootMotion.HasActiveRootMotionSources()) // 非动画根运动源的旋转处理`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FQuat RootMotionRotationQuat;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (CharacterOwner &amp;amp;&amp;amp; UpdatedComponent &amp;amp;&amp;amp; CurrentRootMotion.GetOverrideRootMotionRotation(DeltaSeconds, *CharacterOwner, *this, RootMotionRotationQuat))`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FQuat OldActorRotationQuat = UpdatedComponent-&amp;gt;GetComponentQuat();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FQuat NewActorRotationQuat = RootMotionRotationQuat * OldActorRotationQuat;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; MoveUpdatedComponent(FVector::ZeroVector, NewActorRotationQuat, true);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 消耗路径跟随请求的速度（AI导航相关）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; LastUpdateRequestedVelocity = bHasRequestedVelocity ? RequestedVelocity : FVector::ZeroVector;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; bHasRequestedVelocity = false;`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 触发移动更新委托（用于蓝图和C++事件监听）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OnMovementUpdated(DeltaSeconds, OldLocation, OldVelocity);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; } // 作用域结束，批量移动更新完成`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 调用外部移动后事件（这些事件可能需要使用最新的碰撞重叠状态）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; CallMovementUpdateDelegate(DeltaSeconds, OldLocation, OldVelocity);`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 保存基底位置（用于基于物体的移动）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; if (CharacterMovementCVars::BasedMovementMode == 0)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SaveBaseLocation(); // 旧版本行为`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; else`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; MaybeSaveBaseLocation(); // 优化版本：仅在需要时保存`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; `\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 更新组件速度（用于渲染和其他系统查询）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; UpdateComponentVelocity();`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 网络同步优化：避免移动后网络更新延迟过长`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; const bool bHasAuthority = CharacterOwner &amp;amp;&amp;amp; CharacterOwner-&amp;gt;HasAuthority();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; if (bHasAuthority &amp;amp;&amp;amp; UNetDriver::IsAdaptiveNetUpdateFrequencyEnabled() &amp;amp;&amp;amp; UpdatedComponent)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; UNetDriver* NetDriver = MyWorld-&amp;gt;GetNetDriver();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (NetDriver &amp;amp;&amp;amp; NetDriver-&amp;gt;IsServer())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 如果角色移动了但网络更新被节流，取消节流以立即同步`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (!NetDriver-&amp;gt;IsPendingNetUpdate(CharacterOwner) &amp;amp;&amp;amp; NetDriver-&amp;gt;IsNetworkActorUpdateFrequencyThrottled(CharacterOwner))`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (ShouldCancelAdaptiveReplication())`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; NetDriver-&amp;gt;CancelAdaptiveReplication(CharacterOwner);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 获取移动后的新位置和旋转`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; const FVector NewLocation = UpdatedComponent ? UpdatedComponent-&amp;gt;GetComponentLocation() : FVector::ZeroVector;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; const FQuat NewRotation = UpdatedComponent ? UpdatedComponent-&amp;gt;GetComponentQuat() : FQuat::Identity;`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 服务器端更新变换时间戳（用于客户端插值同步）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; if (bHasAuthority &amp;amp;&amp;amp; UpdatedComponent &amp;amp;&amp;amp; !IsNetMode(NM_Client))`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const bool bLocationChanged = (NewLocation != LastUpdateLocation);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const bool bRotationChanged = (NewRotation != LastUpdateRotation);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (bLocationChanged || bRotationChanged)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 关键网络同步逻辑：使用客户端时间戳而非服务器时间，确保插值平滑`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const bool bIsRemotePlayer = (CharacterOwner-&amp;gt;GetRemoteRole() == ROLE_AutonomousProxy);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const FNetworkPredictionData_Server_Character* ServerData = bIsRemotePlayer ? GetPredictionData_Server_Character() : nullptr;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (bIsRemotePlayer &amp;amp;&amp;amp; ServerData &amp;amp;&amp;amp; CharacterMovementCVars::NetUseClientTimestampForReplicatedTransform)`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 使用客户端累积的时间戳（客户端预测校正的关键）`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ServerLastTransformUpdateTimeStamp = float(ServerData-&amp;gt;ServerAccumulatedClientTimeStamp);`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; else`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 回退到服务器时间`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ServerLastTransformUpdateTimeStamp = MyWorld-&amp;gt;GetTimeSeconds();`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; }`\&lt;/div&gt;&lt;div&gt;\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; // 更新最后一次更新的位置、旋转和速度，用于下一帧计算`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; LastUpdateLocation = NewLocation;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; LastUpdateRotation = NewRotation;`\&lt;/div&gt;&lt;div&gt;`&amp;nbsp; &amp;nbsp; LastUpdateVelocity = Velocity;`\&lt;/div&gt;&lt;div&gt;`}`&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;（AI生成）&lt;/div&gt;" vertex="1">
          <mxGeometry height="6230" width="1420" x="-6815" y="-5050" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mVkl04abXRTLCkiWvBtr" name="Lyra代码的逻辑流程解释">
    <mxGraphModel dx="2356" dy="3936" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="boL5hWOGIqQFWbmAB45p-1" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;void TickComponent(float DeltaTime)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 基础准备&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; InputVector = ConsumeInput(); // 获取玩家输入&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (!IsValid() || IsSimulatingPhysics()) return; // 无效或纯物理模拟则跳过&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 客户端预测校正 (仅自主客户端)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (IsAutonomousClient &amp;amp;&amp;amp; ReceivedServerCorrection)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RollbackToLastServerState(); // 回滚到服务器确认的状态&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ReplayUnackedMoves();&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 重放未确认的本地移动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 执行移动逻辑 (根据网络角色分流)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (IsLocallyControlled)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PerformLocalPrediction(InputVector); // 本地预测：立即更新位置并发送 RPC&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else if (IsServer)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ProcessClientMoves(); // 服务器：验证客户端移动并广播修正&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; InterpolateRemotePosition(); // 模拟端：平滑插值远程角色位置&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 4. 后期处理&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UpdateAvoidance(); // 更新避障&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ApplyPhysicsForces(); // 应用额外物理力&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="470" width="460" x="-1460" y="40" as="geometry" />
        </mxCell>
        <mxCell id="boL5hWOGIqQFWbmAB45p-2" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;// 1. 性能统计与前置准备&lt;/div&gt;&lt;div&gt;启动性能统计标记;&lt;/div&gt;&lt;div&gt;InputVector = 本地消费输入向量();&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// 2. 合法性校验&lt;/div&gt;&lt;div&gt;if (组件无效 || 该帧跳过更新) return;&lt;/div&gt;&lt;div&gt;Super::TickComponent(); // 执行父类基础组件更新&lt;/div&gt;&lt;div&gt;if (二次校验组件无效) return;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// 3. 异步移动分支（物理线程执行）&lt;/div&gt;&lt;div&gt;if (开启异步移动)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 动画TickPose提取根运动;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 缓存根运动参数供异步线程使用;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return; // 主线程直接退出，后续移动逻辑交给物理线程&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// 4. 边界与物理状态校验&lt;/div&gt;&lt;div&gt;if (服务器端角色掉出世界) return;&lt;/div&gt;&lt;div&gt;if (角色处于物理模拟状态（如布娃娃）)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 标记客户端相机更新;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 清空累积外力;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// 5. 非模拟代理角色（本地玩家/服务器受控角色）处理&lt;/div&gt;&lt;div&gt;if (角色权限 &amp;gt; SimulatedProxy)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 客户端收到服务器校正后，执行位置回滚与移动重演;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 延迟Mesh更新至所有移动逻辑结束;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 分支1：本地控制角色（含无控制器但播放根运动/物理的角色）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (满足受控移动条件)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ControlledCharacterMove(InputVector, DeltaTime); // 执行输入驱动的核心移动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (是监听服务器上的主机玩家)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ServerAutonomousProxyTick(DeltaTime); // 主机玩家额外执行服务器权威同步逻辑&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 分支2：服务器端远程客户端角色&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else if (远程角色是AutonomousProxy)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 更新移动基座跟随位置;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ServerAutonomousProxyTick(DeltaTime); // 服务器端执行远程角色权威移动验证&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (监听服务器开启平滑)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SmoothClientPosition(DeltaTime); // 主机本地视图平滑远程角色&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;// 6. 模拟代理角色（其他玩家的远程角色）处理&lt;/div&gt;&lt;div&gt;else if (角色是SimulatedProxy)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 延迟Mesh更新;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 缩小代理角色碰撞胶囊体;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; SimulatedTick(DeltaTime); // 执行网络插值平滑与基座跟随&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;// 7. 后处理逻辑&lt;/div&gt;&lt;div&gt;if (开启RVO避障) 更新避障计算;&lt;/div&gt;&lt;div&gt;if (开启物理交互) 应用向下压力与排斥力;&lt;/div&gt;&lt;div&gt;if (非发布版本开启可视化) 绘制移动调试线条;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="890" width="500" x="-1327" y="-1270" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-1" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;void UCharacterMovementComponent::PerformMovement(float DeltaSeconds)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 前置检查&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (!HasValidData() || DeltaSeconds &amp;lt;= 0.f)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 处理根运动 (Root Motion)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; bool bHasRootMotion = false;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FVector RootMotionTranslation;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FRotator RootMotionRotation;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (ShouldUseRootMotion())&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 从动画实例中提取根运动数据&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ExtractRootMotionFromAnimation(RootMotionTranslation, RootMotionRotation);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; bHasRootMotion = true;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 应用根运动旋转&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ApplyRootMotionRotation(RootMotionRotation);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 根据移动模式执行物理模拟&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // StartNewPhysics 会根据 MovementMode 调用具体的 PhysWalking, PhysFalling 等&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; StartNewPhysics(DeltaSeconds, 0);&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 在 PhysWalking 等函数内部，会执行：&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // - MoveAlongFloor (包含 Sweep, StepUp, Slide)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // - 应用重力&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // - 更新 Velocity&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 4. 如果有根运动位移，额外应用&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (bHasRootMotion)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 将根运动的位移叠加到最终位置上，或用于修正速度&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ApplyRootMotionTranslation(RootMotionTranslation);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 5. 网络同步逻辑&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (Role == ROLE_AutonomousProxy)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 客户端：保存移动数据，发送 ServerMove RPC&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SaveMovedPosition();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SendServerMovePacket();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else if (Role == ROLE_Authority)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 服务器：复制移动状态给其他客户端&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ReplicateMovementToClients();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else if (Role == ROLE_SimulatedProxy)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 模拟代理：通常不在 PerformMovement 中做复杂物理计算，&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 而是通过 OnRep_ReplicatedMovement 进行插值&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 6. 更新地板状态和触发事件&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UpdateFloorFromAdjustment();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; OnMovementUpdated.Broadcast(DeltaSeconds, OldLocation, OldVelocity);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="910" width="490" x="3050" y="-250" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-2" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;void UCharacterMovementComponent::StartNewPhysics(float deltaTime, int32 iterations)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (deltaTime &amp;lt;= 0.f || iterations &amp;gt; MaxSimulationIterations)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 根据当前移动模式调用对应的 Phys 函数&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; switch (MovementMode)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Walking:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysWalking(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Falling:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysFalling(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Swimming:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysSwimming(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; case MOVE_Custom:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PhysCustom(deltaTime, iterations);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; break;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // ... 其他模式&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="500" x="3699" y="-220" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-3" edge="1" parent="1" source="9wMth9zLjm2srs4WxpfN-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1.003;exitY=0.401;exitDx=0;exitDy=0;exitPerimeter=0;" target="9wMth9zLjm2srs4WxpfN-2" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="3719" y="320" as="sourcePoint" />
            <mxPoint x="3879" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-4" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;&lt;div&gt;Function PhysWalking(DeltaTime, Iterations):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 初始化：准备剩余时间&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; remainingTime = DeltaTime&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 子步进循环：将大时间片拆分为小步长以提高精度&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; While (remainingTime &amp;gt; MIN_TICK_TIME AND Iterations &amp;lt; MaxIterations):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // A. 获取当前小步长&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; timeTick = GetSimulationTimeStep(remainingTime, Iterations)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; remainingTime -= timeTick&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Iterations++&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // B. 计算速度：应用摩擦力、加速度和根运动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; MaintainHorizontalGroundVelocity()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CalcVelocity(timeTick, GroundFriction)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ApplyRootMotionToVelocity(timeTick)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // C. 执行移动：沿地板滑动并处理碰撞/台阶&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; MoveAlongFloor(Velocity, timeTick)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // D. 更新状态：重新检测脚下是否有地板&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FindFloor(CurrentLocation, CurrentFloor)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // E. 状态切换判断：&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; If (CurrentFloor.IsWalkableFloor()):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; AdjustFloorHeight() // 贴地&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Else:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; StartFalling()&amp;nbsp; &amp;nbsp; &amp;nbsp; // 掉下去了&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Return&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 退出行走逻辑&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; End While&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;End Function&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="430" x="4399" y="-500" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-5" edge="1" parent="1" source="9wMth9zLjm2srs4WxpfN-2" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1.002;exitY=0.404;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-4" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="4289" as="sourcePoint" />
            <mxPoint x="4449" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-6" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;Function ControlledCharacterMove(Input, DeltaTime):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 处理跳跃 (优先于加速度计算，以减少延迟)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CheckJump()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 计算本帧的意图加速度&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Acceleration = ProcessInput(Input)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 根据身份执行移动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; If IsServerOrSinglePlayer:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 【权威端】直接执行物理模拟，结果即为最终真理&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 51);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: rgb(236, 236, 236);&quot;&gt;PerformMovement&lt;/span&gt;&lt;span&gt;()&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Else If IsLocalClientPlayer:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 【客户端】预测 + 同步&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PredictLocalMovement()&amp;nbsp; &amp;nbsp;// 立即本地更新，保证手感流畅&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SendMoveToServer()&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;// 发送数据给服务器验证&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; End If&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;End Function&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="360" x="1294" y="-200" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-7" edge="1" parent="1" source="boL5hWOGIqQFWbmAB45p-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-6" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="730" y="130" as="sourcePoint" />
            <mxPoint x="890" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-8" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;/**&lt;/div&gt;&lt;div&gt;&amp;nbsp;* ServerAutonomousProxyTick&lt;/div&gt;&lt;div&gt;&amp;nbsp;*&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 描述：&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 在服务器端执行自主代理（Autonomous Proxy）角色的移动更新。&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 对于 Listen Server 的主机玩家，此函数在 TickComponent 中被直接调用。&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 对于专用服务器上的远程玩家，类似的逻辑在 ServerMove_Implementation 中执行。&lt;/div&gt;&lt;div&gt;&amp;nbsp;*&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 主要职责：&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 1. 计算准确的时间步长 (DeltaTime)。&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 2. 重演客户端的移动输入 (Replay Movement)。&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 3. 验证移动合法性并检测误差。&lt;/div&gt;&lt;div&gt;&amp;nbsp;* 4. 准备网络校正数据 (Client Adjustment)。&lt;/div&gt;&lt;div&gt;&amp;nbsp;*/&lt;/div&gt;&lt;div&gt;void UCharacterMovementComponent::ServerAutonomousProxyTick(float DeltaTime)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 前置检查：确保角色拥有权威权限且处于有效状态&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (!CharacterOwner || !IsNetMode(NM_ListenServer) &amp;amp;&amp;amp; !IsNetMode(NM_DedicatedServer))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 处理基于基座的移动 (Based Movement)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 在计算移动前，先让角色跟随其站立的移动平台（如电梯、火车）一起移动。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 这确保了后续的物理计算是在正确的世界坐标基础上进行的。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; MaybeUpdateBasedMovement(DeltaTime);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 保存当前的基座位置信息&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 用于后续的网络同步和误差校正，区分“平台移动”和“角色自身移动”。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; MaybeSaveBaseLocation();&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 4. 执行权威移动模拟 (Core Logic)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 这是最关键的一步。它会调用 MoveAutonomous 或 PerformMovement。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 如果是 Listen Server 主机：&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;- 直接使用传入的 DeltaTime。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;- 使用当前帧的输入数据（因为主机本地已经处理了输入）。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 如果是处理远程客户端 RPC (通常在 ServerMove_Implementation 中)：&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;- 使用客户端发送的时间戳计算 DeltaTime，防止时间作弊。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;- 使用客户端发送的压缩输入数据 (Compressed Flags, Acceleration, etc.)。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 内部流程：&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;a. 应用重力、摩擦力等物理规则。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;b. 根据输入加速度计算速度变化。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;c. 进行碰撞检测 (Sweep/MoveComponent)。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp;d. 更新角色的世界位置 (Location) 和旋转 (Rotation)。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; MoveAutonomous(DeltaTime, /* 其他参数如 TimeStamp, CompressedFlags 等 */);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 5. 错误检测与校正准备 (Error Detection)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 服务器会将计算出的“权威位置”与客户端在 RPC 中报告的“预期位置”进行比较。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 注意：对于 Listen Server 主机，这一步可能简化，因为本地预测和服务器模拟是同一帧完成的，&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 误差通常极小。但对于远程客户端，这是反作弊和同步的核心。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (ShouldCheckForErrors())&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 计算位置误差 (Position Error)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; float PositionError = FVector::Dist(ServerComputedLocation, ClientReportedLocation);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 如果误差超过阈值 (MaxClientError)，标记需要校正&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (PositionError &amp;gt; MaxClientError)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; bPendingCorrection = true;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PendingAdjustment.Location = ServerComputedLocation;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PendingAdjustment.Velocity = UpdatedComponent-&amp;gt;Velocity;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PendingAdjustment.TimeStamp = CurrentServerTime;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; else&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 移动合法，发送 ACK (Acknowledgement)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 客户端收到 ACK 后会从 SavedMoves 队列中移除已确认的移动包&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SendClientAckGoodMove();&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 6. 更新网络复制变量 (Replication)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 将最新的权威位置、速度、基座信息复制到 ReplicatedMovement 结构体中。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 这些数据会在后续的 Actor 复制 (Actor Replication) 阶段发送给所有相关的客户端。&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UpdateReplicatedMovement();&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1180" width="560" x="1294" y="220" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-9" edge="1" parent="1" source="boL5hWOGIqQFWbmAB45p-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1;exitY=0.641;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-8" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="920" y="310" as="sourcePoint" />
            <mxPoint x="1080" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-10" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;FUNCTION SimulatedTick(DeltaTime):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 【高优先级】处理根运动 (Root Motion)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF 正在播放网络同步的根运动动画 OR 有活跃的根运动源:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // A. 接收服务器权威数据&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IF 收到服务器的根运动修正包:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 强制将角色位置/旋转对齐到服务器数据&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 更新速度、加速度和根运动状态&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // B. 执行本地模拟&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 更新动画姿态&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 应用根运动位移 (PerformMovement / SimulateRootMotion)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // C. 标记状态&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 标记 &quot;正在模拟根运动&quot; = True&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 【常规情况】处理普通移动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ELSE:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // A. 状态重置 (如果刚从根运动切换回来)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IF 之前正在模拟根运动:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 清空根运动缓冲队列&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 强制同步一次服务器的基础移动数据 (位置/速度/模式)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 标记 &quot;正在模拟根运动&quot; = False&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // B. 执行本地模拟&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IF 有简单的根运动动画:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PerformMovement() // 物理驱动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ELSE:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SimulateMovement() // 速度积分驱动 (最常用)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 【最终步骤】视觉平滑 (Network Smoothing)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 无论上面走哪个分支，最后都要处理视觉表现&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF 网络平滑未完成:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 核心目的：让 Mesh (模型) 平滑地追赶 Capsule (碰撞体)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 避免因为服务器修正导致的模型瞬移或抖动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SmoothClientPosition(DeltaTime)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="550" width="360" x="827" y="330" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-11" edge="1" parent="1" source="boL5hWOGIqQFWbmAB45p-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-10" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="640" y="340" as="sourcePoint" />
            <mxPoint x="800" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-12" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;FUNCTION UpdateDefaultAvoidance():&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 【前置检查】是否启用 RVO 避障？&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF bUseRVOAvoidance 为 False:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 直接返回 (不做任何处理)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 【核心更新】执行 RVO 避障计算&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF 避障管理器存在&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AND 本帧尚未更新过避障 (!bWasAvoidanceUpdated)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AND 角色拥有有效的胶囊体碰撞组件:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // A. 向全局管理器注册当前状态，计算避障速度&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; AvoidanceManager.UpdateRVO(当前角色)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // B. 设置速度锁定 (防止抖动)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 视为一次“干净”的移动，锁定速度一段时间以保持平滑&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; SetAvoidanceVelocityLock(锁定时间 = LockTimeAfterClean)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 【状态重置】为下一帧做准备&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; bWasAvoidanceUpdated = False&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="370" x="320" y="470" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-13" edge="1" parent="1" source="boL5hWOGIqQFWbmAB45p-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1;exitY=0.877;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-12" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="510" y="420" as="sourcePoint" />
            <mxPoint x="670" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-14" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;FUNCTION ApplyDownwardForce(DeltaSeconds):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 【前置检查】是否启用向下力且角色站在地面上？&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF StandingDownwardForceScale == 0&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;OR 当前脚下没有有效的碰撞命中:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 直接返回 (不执行任何操作)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 【获取对象】获取脚下的物理组件和重力向量&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; BaseComponent = 获取脚下碰撞组件()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; GravityVector = 计算当前重力方向与大小()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 【核心逻辑】仅对动态物理物体施加力&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF BaseComponent 存在&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AND BaseComponent 正在模拟物理 (IsSimulatingPhysics)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AND 重力不为零:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // A. 计算力的大小：重力 * 角色质量 * 配置系数&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ForceMagnitude = GravityVector * CharacterMass * StandingDownwardForceScale&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // B. 在接触点施加力&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 目的：增加正压力，从而增加摩擦力，防止在移动平台上滑动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; BaseComponent.AddForceAtLocation(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Force = ForceMagnitude,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Location = 碰撞接触点,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; BoneName = 骨骼名称(如果有)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; )&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="490" x="-210" y="580" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-15" edge="1" parent="1" source="boL5hWOGIqQFWbmAB45p-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=0.998;exitY=0.929;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-14" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="-630" y="620" as="sourcePoint" />
            <mxPoint x="-470" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-16" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;FUNCTION ApplyRepulsionForce(DeltaSeconds):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 【前置检查】是否启用斥力且存在有效碰撞体？&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF UpdatedPrimitive 不存在&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;OR RepulsionForce &amp;lt;= 0&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;OR CharacterOwner 不存在:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 直接返回&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 【获取重叠信息】获取所有与角色胶囊体重叠的组件&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; OverlapList = UpdatedPrimitive.GetOverlapInfos()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; IF OverlapList 为空:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 直接返回&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 【遍历重叠对象】逐个处理每个重叠的物理物体&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FOR EACH Overlap IN OverlapList:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OverlapComp = Overlap.Component&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // A. 过滤无效对象：必须存在、可移动、且正在模拟物理&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IF OverlapComp 不存在&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;OR OverlapComp 不可移动 (Static/Kinematic)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;OR OverlapBody 未模拟物理:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CONTINUE (跳过当前对象)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // B. 获取物理实体 (BodyInstance)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 支持骨骼网格体的多身体检测&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OverlapBody = 获取对应的 FBodyInstance()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IF OverlapBody 不存在:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CONTINUE&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // C. 计算相对位置与预测位置&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; BodyLocation = OverlapBody.GetLocation()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; BodyVelocity = OverlapBody.GetVelocity()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; MyLocation = 角色当前位置&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 在重力平面投影下计算距离（忽略垂直高度差异，主要关注水平挤压）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; DistNow = 投影距离平方(BodyLocation, MyLocation)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; DistLater = 投影距离平方(BodyLocation + BodyVelocity * DeltaSeconds, MyLocation)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 执行射线检测，判断是否穿透或接触表面&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; HitResult = LineTrace(MyLocation, BodyLocation)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IsPenetrating = HitResult.bStartPenetrating OR PenetrationDepth &amp;gt; StopBodyDistance&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // D. 【决策逻辑】决定是“停止”还是“推开”&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 情况1：轻微接触且未穿透 -&amp;gt; 强制停止物体速度（防止微小抖动/摩擦滑动）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IF HitResult 有效&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AND DistNow &amp;lt; StopBodyDistance (阈值约2.5f)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AND NOT IsPenetrating:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OverlapBody.SetLinearVelocity(ZeroVector)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 情况2：正在靠近 或 已经穿透 -&amp;gt; 施加径向斥力&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ELSE IF DistLater &amp;lt;= DistNow OR IsPenetrating:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 确定斥力中心点 ForceCenter&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; IF HitResult 有效:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ForceCenter = HitResult.ImpactPoint (接触点)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ELSE:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 如果在内部，限制在胶囊体高度范围内&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ForceCenter = Clamp(BodyLocation.Z, CapsuleMinZ, CapsuleMaxZ)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 施加斥力&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 力的大小 = RepulsionForce * Mass&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 作用范围 = CapsuleRadius * 1.2&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OverlapBody.AddRadialForce(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Origin = ForceCenter,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Radius = CapsuleRadius * 1.2,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Strength = RepulsionForce * CharacterMass,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Falloff = Constant&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; )&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; END FOR&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1050" width="510" x="-930" y="680" as="geometry" />
        </mxCell>
        <mxCell id="9wMth9zLjm2srs4WxpfN-17" edge="1" parent="1" source="boL5hWOGIqQFWbmAB45p-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1.001;exitY=0.963;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-16" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="-940" y="620" as="sourcePoint" />
            <mxPoint x="-780" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y5gw1dJ1zvbBJpn4hvVI-1" parent="1" style="html=1;whiteSpace=wrap;align=left;" value="&lt;div&gt;&lt;div&gt;Function ReplicateMoveToServer(DeltaTime, Acceleration):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 1. 准备阶段：更新时间戳并创建移动记录&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; UpdateNetworkTimeStamp()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; NewMove = CreateSavedMove(DeltaTime, Acceleration)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 2. 优化阶段：尝试合并上一帧未发送的移动（减少包数量）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; If (PendingMove Exists AND CanCombine(NewMove, PendingMove)):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Combine(NewMove, PendingMove)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Clear(PendingMove)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 3. 预测阶段：本地立即执行物理模拟（保证零延迟手感）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; PerformMovement(NewMove.DeltaTime)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // 4. 发送阶段：决定是“立即发送”还是“暂存等待合并”&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; If (ShouldDelaySending()):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; PendingMove = NewMove&amp;nbsp; // 暂存，等待下一帧一起发&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Else:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; OldMove = GetOldestUnackedMove() // 获取最老的未确认移动&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; RPC_ServerMove(NewMove, OldMove) // 发送给服务器验证&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;End Function&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="410" x="2160" y="105" as="geometry" />
        </mxCell>
        <mxCell id="Y5gw1dJ1zvbBJpn4hvVI-2" edge="1" parent="1" source="Y5gw1dJ1zvbBJpn4hvVI-8" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1.004;exitY=0.175;exitDx=0;exitDy=0;exitPerimeter=0;" target="Y5gw1dJ1zvbBJpn4hvVI-12" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="5810" y="-1110" as="sourcePoint" />
            <mxPoint x="5970" y="-1110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y5gw1dJ1zvbBJpn4hvVI-3" edge="1" parent="1" source="9wMth9zLjm2srs4WxpfN-6" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="Y5gw1dJ1zvbBJpn4hvVI-1" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="1850" y="120" as="sourcePoint" />
            <mxPoint x="2010" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y5gw1dJ1zvbBJpn4hvVI-5" edge="1" parent="1" source="Y5gw1dJ1zvbBJpn4hvVI-1" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;horizontal=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="9wMth9zLjm2srs4WxpfN-1" value="">
          <mxGeometry relative="1" width="160" as="geometry">
